# Base URL of the backend API. Used by src/api/client.ts and the SignalR hub
# factory. The operations screens do not read it yet: /api/auth/* and
# /api/staff/* do not exist, so the app runs on the fixtures in src/mocks/.
VITE_API_BASE_URL=http://localhost:5000

# Quest 3 live stream (robot/quest-stream on the robot NUC). Optional: when set,
# the student live view (/tour/*) and the staff start-check preview play it
# instead of their current video source. Replace the IP with the NUC's IP.
# VITE_QUEST_STREAM_URL=http://10.80.192.207:8080/hls/quest.m3u8
