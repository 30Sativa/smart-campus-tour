# Base URL of the backend API. Used by src/api/client.ts and the SignalR hub
# factory. The operations screens do not read it yet: /api/auth/* and
# /api/staff/* do not exist, so the app runs on the fixtures in src/mocks/.
VITE_API_BASE_URL=http://localhost:5000

# Quest 3 live stream over WebRTC: MediaMTX on the robot NUC (fed by
# robot/quest-stream). Optional: when set, the student live view (/tour/*) and
# the staff start-check preview play it instead of their current video source.
# Replace the IP with the NUC's IP. The page must be served over http (or the
# NUC over https): browsers block an http stream on an https page.
# VITE_QUEST_WHEP_URL=http://10.80.192.207:8889/quest/whep
# Only for viewers outside the robot's LAN (comma separated STUN URLs):
# VITE_QUEST_ICE_SERVERS=stun:stun.l.google.com:19302

# Real robot positions from the backend (/hubs/fleet): `on` makes the Staff 3D
# twin and the Student 2D map show robots that post to POST /api/robots/telemetry.
# Unset keeps the mock data. The backend must allow this origin
# (RobotTelemetry:AllowedOrigins) and, in Development, may set
# RobotTelemetry:AllowAnonymousViewers=true until sign-in exists.
# VITE_FLEET_HUB=on
