#!/usr/bin/env bash
# digital-twin/ verification gate. Exit 0 = PASS, non-zero = FAIL.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

SOLUTION="SmartCampus.DigitalTwin.slnx"
DOTNET="dotnet"

if ! command -v "$DOTNET" > /dev/null 2>&1; then
  if command -v dotnet.exe > /dev/null 2>&1; then
    DOTNET="dotnet.exe"
  else
    echo "FAIL: dotnet SDK is not available on PATH."
    exit 1
  fi
fi

if [ -f "$SOLUTION" ]; then
  TARGET="$SOLUTION"
elif compgen -G "src/*/*.csproj" > /dev/null; then
  TARGET="$(find src -maxdepth 2 -name '*.csproj' -print -quit)"
else
  echo "SKIPPED: digital-twin/ has no .slnx or .csproj. Nothing to verify."
  exit 3
fi

"$DOTNET" restore "$TARGET"
"$DOTNET" build "$TARGET" --no-restore
"$DOTNET" test "$TARGET" --no-build

echo "PASS"
