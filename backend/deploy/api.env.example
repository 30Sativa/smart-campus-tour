# Copy to backend/deploy/api.env. This file is read only by API/seed containers.
# Enable invitations and the worker together after completing every setting.
Invitations__Enabled=false
Invitations__EmailWorkerEnabled=false
Invitations__HashKey=
Invitations__ProtectionKey=
Invitations__PublicBaseUrl=https://tour.example.com
Invitations__SupportEmail=support@example.com
Resend__ApiKey=
Resend__From=CampusTour <noreply@example.com>
# Swagger UI/OpenAPI (backend/docs/api-documentation.md). Enabling it outside
# Development requires both values; password: openssl rand -hex 24.
ApiDocumentation__Enabled=false
ApiDocumentation__Username=
ApiDocumentation__Password=
# Operator head buttons and the automatic POI sweep (backend/docs/fleet-head.md).
# Off by default; the robot also needs fleet_bridge head_enabled: true.
FleetHead__Enabled=false
# Public Quest relay (ADR-0055, robot/quest-stream/README.md "Phát ra Internet").
# install-relay.sh prints these lines; all empty = no viewer gets a token.
QuestRelay__WhepUrl=
QuestRelay__RobotCode=
QuestRelay__Key=
QuestRelay__PublishUser=
QuestRelay__PublishPasswordSha256=
