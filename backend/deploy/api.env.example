# Copy to backend/deploy/api.env. This file is read only by API/seed containers.
# Enable invitations and the worker together after completing every setting.
Invitations__Enabled=false
Invitations__EmailWorkerEnabled=false
Invitations__HashKey=
Invitations__ProtectionKey=
Invitations__PublicBaseUrl=https://tour.example.com
Invitations__SupportEmail=support@example.com
Resend__ApiKey=
Resend__From=CampusTour <noreply@example.com>
