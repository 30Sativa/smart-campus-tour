  (NEWID(), N'pilot', 2, N'pilot-v2', N'b.zip', @sha, @sha, 0x01, N'map.pgm', 1, 1, 1, 0, 0, 0, 0, 0.65, 0.196, N'map', 'VALID', @user, NEWID(), @now);
