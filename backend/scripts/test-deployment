#!/usr/bin/env bash
# Disposable Linux Docker verification. Never targets the production Compose project.
# From repo root: bash backend/scripts/test-deployment
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.."
for tool in docker openssl curl; do
  command -v "$tool" >/dev/null || { echo "Required tool: $tool" >&2; exit 1; }
done
docker info >/dev/null

scratch=$(mktemp -d)
project="campustour-test-$(date +%s)-$$"
[[ "$project" =~ ^campustour-test-[0-9]+-[0-9]+$ ]] || { echo 'Unsafe disposable project name.' >&2; rmdir "$scratch"; exit 1; }
[[ "$project" != campustour ]] || { echo 'Refusing the production project name.' >&2; rmdir "$scratch"; exit 1; }
if [[ -n "$(docker ps -aq --filter "label=com.docker.compose.project=$project")" ||
      -n "$(docker volume ls -q --filter "label=com.docker.compose.project=$project")" ||
      -n "$(docker network ls -q --filter "label=com.docker.compose.project=$project")" ]]; then
  echo 'Disposable project name already has Docker resources; refusing cleanup.' >&2
  rmdir "$scratch"
  exit 1
fi

backend_image=${BACKEND_IMAGE:-campustour-backend:deployment-test}
db_init_image=${DB_INIT_IMAGE:-campustour-db-init:deployment-test}
sqlserver_image=${SQLSERVER_IMAGE:-mcr.microsoft.com/mssql/server:2022-CU27-ubuntu-22.04}
dc=(docker compose --project-name "$project" --env-file "$scratch/test.env" -f backend/docker-compose.yml)
cleanup() {
  local resource label safe=1
  if [[ ! "$project" =~ ^campustour-test-[0-9]+-[0-9]+$ || "$project" == campustour ]]; then
    safe=0
  fi
  while read -r resource; do
    [[ -z "$resource" ]] && continue
    label=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$resource" 2>/dev/null || true)
    [[ "$label" == "$project" ]] || safe=0
  done < <(docker ps -aq --filter "label=com.docker.compose.project=$project" 2>/dev/null || true)
  while read -r resource; do
    [[ -z "$resource" ]] && continue
    label=$(docker volume inspect --format '{{index .Labels "com.docker.compose.project"}}' "$resource" 2>/dev/null || true)
    [[ "$label" == "$project" ]] || safe=0
  done < <(docker volume ls -q --filter "label=com.docker.compose.project=$project" 2>/dev/null || true)
  while read -r resource; do
    [[ -z "$resource" ]] && continue
    label=$(docker network inspect --format '{{index .Labels "com.docker.compose.project"}}' "$resource" 2>/dev/null || true)
    [[ "$label" == "$project" ]] || safe=0
  done < <(docker network ls -q --filter "label=com.docker.compose.project=$project" 2>/dev/null || true)
  if [[ $safe == 1 ]]; then
    "${dc[@]}" down --volumes --remove-orphans >/dev/null || true
  else
    echo 'Refusing cleanup because disposable Docker ownership could not be established.' >&2
  fi
  rm -f "$scratch/test.env" "$scratch/api.env" "$scratch/cert.pem" "$scratch/key.pem" \
    "$scratch/login.json" "$scratch/cookies" "$scratch/response.json" "$scratch/ready.json" \
    "$scratch/backups/campustour-smoke.bak"
  rmdir "$scratch/backups" 2>/dev/null || true
  rmdir "$scratch" 2>/dev/null || true
}
mkdir -p "$scratch/backups"
chmod 0777 "$scratch/backups"
trap cleanup EXIT

admin_password="Aa1!$(openssl rand -hex 32)"
cat > "$scratch/test.env" <<ENV
COMPOSE_PROJECT_NAME=$project
BACKEND_IMAGE=$backend_image
DB_INIT_IMAGE=$db_init_image
SQLSERVER_IMAGE=$sqlserver_image
MSSQL_PID=Express
MSSQL_MEMORY_LIMIT_MB=2048
SQLSERVER_MEMORY_LIMIT=2560m
SQLSERVER_CPUS=1.25
API_MEMORY_LIMIT=512m
API_CPUS=0.75
DB_INIT_MEMORY_LIMIT=192m
DB_INIT_CPUS=0.25
SQL_SA_PASSWORD=Aa1!$(openssl rand -hex 32)
SQL_APP_PASSWORD=Aa1!$(openssl rand -hex 32)
JWT_SIGNING_KEY=$(openssl rand -hex 32)
API_HOST=localhost
WEB_ORIGIN=https://tour.example.test
API_HTTPS_PORT=${DEPLOYMENT_TEST_PORT:-18443}
API_BIND_IP=127.0.0.1
API_ENV_FILE=$scratch/api.env
TLS_CERT_PATH=$scratch/cert.pem
TLS_KEY_PATH=$scratch/key.pem
SQL_BACKUP_DIR=$scratch/backups
INITIAL_ADMIN_USERNAME=deployment.admin
INITIAL_ADMIN_PASSWORD=$admin_password
INITIAL_ADMIN_FULL_NAME=Deployment Test Admin
ENV
cp backend/deploy/api.env.example "$scratch/api.env"
openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj '/CN=localhost' \
  -addext 'subjectAltName=DNS:localhost' -keyout "$scratch/key.pem" -out "$scratch/cert.pem" >/dev/null 2>&1
# This key and database exist only in this unique disposable test project.
chmod 644 "$scratch/key.pem" "$scratch/cert.pem"

if [[ ${DEPLOYMENT_TEST_BUILD_IMAGES:-true} == true ]]; then
  docker build --pull --target runtime --tag "$backend_image" --file backend/Dockerfile backend
  docker build --pull --target db-init --tag "$db_init_image" --file backend/Dockerfile backend
else
  docker image inspect "$backend_image" >/dev/null
  docker image inspect "$db_init_image" >/dev/null
fi
api_image_id=$(docker image inspect --format '{{.Id}}' "$backend_image")
db_init_image_id=$(docker image inspect --format '{{.Id}}' "$db_init_image")
"${dc[@]}" config --quiet
"${dc[@]}" up -d --wait --wait-timeout 240 api
printf 'Tested API image config: %s\nTested initializer image config: %s\n' "$api_image_id" "$db_init_image_id"

seed_admin() { "${dc[@]}" run -T --rm seed-admin; }
seed_admin
seed_admin
"${dc[@]}" run -T --rm --no-deps db-init

sql_as_sa() {
  "${dc[@]}" exec -T sqlserver /bin/bash -c \
    'export SQLCMDPASSWORD="$MSSQL_SA_PASSWORD"; exec /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -C -b -l 10 "$@"' -- "$@"
}
assert_login() {
  printf '{"username":"deployment.admin","password":"%s"}' "$admin_password" > "$scratch/login.json"
  curl --fail --silent --show-error --insecure \
    "https://localhost:${DEPLOYMENT_TEST_PORT:-18443}/api/auth/login" \
    -H 'Content-Type: application/json' --data-binary "@$scratch/login.json" \
    -D "$scratch/cookies" -o "$scratch/response.json"
  grep -qi 'campustour.refresh=.*secure' "$scratch/cookies"
  grep -q 'accessToken' "$scratch/response.json"
}
assert_login

live_status=$(curl --silent --show-error --insecure --max-time 5 --output /dev/null \
  --write-out '%{http_code}' "https://localhost:${DEPLOYMENT_TEST_PORT:-18443}/health/live")
ready_status=$(curl --silent --show-error --insecure --max-time 5 --output "$scratch/ready.json" \
  --write-out '%{http_code}' "https://localhost:${DEPLOYMENT_TEST_PORT:-18443}/health/ready")
test "$live_status" = 204
test "$ready_status" = 200
grep -q '"status":"ready"' "$scratch/ready.json"
test "$("${dc[@]}" exec -T api id -u | tr -d '\r')" != 0
"${dc[@]}" exec -T api sh -c 'touch /tmp/deployment-test && rm /tmp/deployment-test'
if "${dc[@]}" exec -T api sh -c 'touch /app/deployment-test'; then
  echo 'API root filesystem must be read-only.' >&2
  exit 1
fi
"${dc[@]}" exec -T api test ! -e /app/appsettings.Development.json
if api_port=$("${dc[@]}" port sqlserver 1433 2>/dev/null) && [[ -n "$api_port" ]]; then
  echo 'Database port must not be published.' >&2
  exit 1
fi

# Exercise an actual checked backup and restore into a disposable database name.
sql_as_sa -Q "BACKUP DATABASE [SmartCampusTourV11] TO DISK=N'/var/opt/mssql/backup/campustour-smoke.bak' WITH CHECKSUM, INIT; RESTORE VERIFYONLY FROM DISK=N'/var/opt/mssql/backup/campustour-smoke.bak' WITH CHECKSUM;"
sql_as_sa -Q "DECLARE @data sysname=(SELECT TOP(1) name FROM SmartCampusTourV11.sys.database_files WHERE type=0 ORDER BY file_id); DECLARE @log sysname=(SELECT TOP(1) name FROM SmartCampusTourV11.sys.database_files WHERE type=1 ORDER BY file_id); IF @data IS NULL OR @log IS NULL THROW 51020, 'Expected one data and one log file.', 1; DECLARE @sql nvarchar(max)=N'RESTORE DATABASE [CampustourRestoreDrill] FROM DISK=N''/var/opt/mssql/backup/campustour-smoke.bak'' WITH MOVE=N''' + REPLACE(@data,'''','''''') + N''' TO N''/var/opt/mssql/data/CampustourRestoreDrill.mdf'', MOVE=N''' + REPLACE(@log,'''','''''') + N''' TO N''/var/opt/mssql/data/CampustourRestoreDrill.ldf'', RECOVERY;'; EXEC sys.sp_executesql @sql; IF (SELECT COUNT(*) FROM CampustourRestoreDrill.sys.tables WHERE is_ms_shipped=0)<>17 THROW 51021, 'Restored schema is incomplete.', 1; DBCC CHECKDB(N'CampustourRestoreDrill') WITH NO_INFOMSGS;"

# Verify the live/readiness distinction during an SQL outage and recover.
"${dc[@]}" stop --timeout 10 sqlserver >/dev/null
live_status=$(curl --silent --show-error --insecure --max-time 5 --output /dev/null \
  --write-out '%{http_code}' "https://localhost:${DEPLOYMENT_TEST_PORT:-18443}/health/live")
ready_status=$(curl --silent --show-error --insecure --max-time 5 --output /dev/null \
  --write-out '%{http_code}' "https://localhost:${DEPLOYMENT_TEST_PORT:-18443}/health/ready")
test "$live_status" = 204
test "$ready_status" = 503
"${dc[@]}" start sqlserver >/dev/null
"${dc[@]}" up -d --wait --wait-timeout 240 api
ready_status=$(curl --fail --silent --show-error --insecure --max-time 5 --output /dev/null \
  --write-out '%{http_code}' "https://localhost:${DEPLOYMENT_TEST_PORT:-18443}/health/ready")
test "$ready_status" = 200

# Verify effective permissions with the actual API login, not sa.
"${dc[@]}" run -T --rm --no-deps --entrypoint /bin/bash db-init -c \
  'export SQLCMDPASSWORD="$SQL_APP_PASSWORD"; exec /opt/mssql-tools18/bin/sqlcmd -S sqlserver -U smartcampus_api -C -b -d SmartCampusTourV11' <<'SQL'
SET NOCOUNT ON;
IF IS_SRVROLEMEMBER('sysadmin') <> 0 OR IS_ROLEMEMBER('db_owner') <> 0
    THROW 51000, 'Runtime user is privileged.', 1;
IF (SELECT COUNT(*) FROM sys.tables WHERE is_ms_shipped=0) <> 17
    THROW 51001, 'Expected all 17 v1.1 tables.', 1;
IF (SELECT COUNT(*) FROM dbo.Users WHERE NormalizedUsername=N'DEPLOYMENT.ADMIN') <> 1
    THROW 51002, 'Seed must be idempotent.', 1;
IF HAS_PERMS_BY_NAME('dbo.AuditLogs', 'OBJECT', 'INSERT') <> 1
    OR HAS_PERMS_BY_NAME('dbo.TourEvents', 'OBJECT', 'INSERT') <> 1
    THROW 51006, 'Runtime must be able to append logs.', 1;
SELECT TOP (1) Id FROM dbo.Tours WITH (UPDLOCK, ROWLOCK);
IF HAS_PERMS_BY_NAME('dbo.Routes', 'OBJECT', 'INSERT') <> 1
    OR HAS_PERMS_BY_NAME('dbo.Routes', 'OBJECT', 'UPDATE') <> 1
    OR HAS_PERMS_BY_NAME('dbo.Routes', 'OBJECT', 'DELETE') <> 1
    OR HAS_PERMS_BY_NAME('dbo.RouteStops', 'OBJECT', 'DELETE') <> 1
    OR HAS_PERMS_BY_NAME('dbo.Tours', 'OBJECT', 'INSERT') <> 1
    OR HAS_PERMS_BY_NAME('dbo.Tours', 'OBJECT', 'UPDATE') <> 1
    OR HAS_PERMS_BY_NAME('dbo.Tours', 'OBJECT', 'DELETE') <> 0
    THROW 51007, 'Runtime permissions do not match Route/Tour preparation.', 1;
BEGIN TRY
    EXEC(N'UPDATE dbo.AuditLogs SET ResultCode=''FAILED'' WHERE 1=0;');
    THROW 51003, 'Audit update must be denied.', 1;
END TRY
BEGIN CATCH
    IF ERROR_NUMBER() <> 229 THROW;
END CATCH;
BEGIN TRY
    EXEC(N'DELETE FROM dbo.TourEvents WHERE 1=0;');
    THROW 51004, 'Tour log delete must be denied.', 1;
END TRY
BEGIN CATCH
    IF ERROR_NUMBER() <> 229 THROW;
END CATCH;
BEGIN TRY
    EXEC(N'CREATE TABLE dbo.DeploymentTestForbidden(Id int);');
    THROW 51005, 'DDL must be denied.', 1;
END TRY
BEGIN CATCH
    IF ERROR_NUMBER() <> 262 THROW;
END CATCH;
SQL

# Recreate containers but retain the disposable volume and verify persistent data.
"${dc[@]}" down
"${dc[@]}" up -d --wait --wait-timeout 240 api
assert_login
sql_as_sa -Q "EXEC sys.sp_dropextendedproperty @name=N'CampusTourBootstrapHash';"
if "${dc[@]}" run -T --rm --no-deps db-init; then
  echo 'Initializer must reject an existing unmarked database.' >&2
  exit 1
fi
sql_as_sa -Q "IF (SELECT COUNT(*) FROM dbo.Users WHERE NormalizedUsername=N'DEPLOYMENT.ADMIN') <> 1 THROW 51000, 'Guard changed existing data.', 1;"
echo 'PASS: immutable images, Compose gating, HTTPS login/cookie, live/readiness, SQL permissions, backup/restore, persistence and existing-database guard.'
