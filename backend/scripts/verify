#!/usr/bin/env bash
# backend/scripts/verify — exit 0 = PASS, exit != 0 = FAIL. Không nuốt lỗi bằng `|| true`.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

SOLUTION="SmartCampus.slnx"

if [ ! -f "$SOLUTION" ]; then
  echo "FAIL: không tìm thấy $SOLUTION trong backend/."
  exit 1
fi

dotnet restore "$SOLUTION"
dotnet build "$SOLUTION" -warnaserror --no-restore

if compgen -G "tests/*/*.csproj" > /dev/null; then
  dotnet test "$SOLUTION" --no-build
else
  echo "WARN: chưa có project test nào trong tests/ — bỏ qua dotnet test."
fi

# Nếu đã có migration: fail khi model đổi mà chưa sinh migration.
if compgen -G "src/SmartCampus.Infrastructure/Persistence/Migrations/*.cs" > /dev/null; then
  dotnet ef migrations has-pending-model-changes \
    --project src/SmartCampus.Infrastructure \
    --startup-project src/SmartCampus.Api
fi

echo "PASS"
