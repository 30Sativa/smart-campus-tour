#!/usr/bin/env bash
# backend/scripts/verify — exit 0 = PASS, exit != 0 = FAIL. Không nuốt lỗi bằng `|| true`.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

SOLUTION="SmartCampus.slnx"
DOTNET="dotnet"
PYTHON=${SMARTCAMPUS_PYTHON:-python3}

if ! command -v "$DOTNET" > /dev/null 2>&1; then
  if command -v dotnet.exe > /dev/null 2>&1; then
    DOTNET="dotnet.exe"
  else
    echo "FAIL: dotnet SDK is not available on PATH."
    exit 1
  fi
fi

if [ ! -f "$SOLUTION" ]; then
  echo "FAIL: không tìm thấy $SOLUTION trong backend/."
  exit 1
fi

sql_test_connection=${SMARTCAMPUS_SCHEMA_TEST_CONNECTION:-}
if [[ ${SMARTCAMPUS_REQUIRE_SQL_TESTS:-false} == true && -z ${sql_test_connection//[[:space:]]/} ]]; then
  echo 'FAIL: required SQL verification needs a disposable SMARTCAMPUS_SCHEMA_TEST_CONNECTION.' >&2
  exit 1
fi

results_dir=${SMARTCAMPUS_TEST_RESULTS_DIR:-"${TMPDIR:-/tmp}/campustour-test-results-$$"}
mkdir -p "$results_dir"

bash -n deploy/init-db.sh deploy/deploy-ec2.sh deploy/install-host-tools.sh deploy/backup-sqlserver.sh deploy/check-ec2.sh \
  deploy/stack-start.sh deploy/refresh-certificate.sh scripts/test-deployment scripts/test-deploy-ec2.sh \
  scripts/test-backup-upload-failure.sh scripts/test-certificate-reconciliation.sh scripts/test-operation-locks.sh
bash -n deploy/prepare-release.sh deploy/ssh-deploy.sh deploy/receive-release.sh
bash -n scripts/resolve-base-images
"$PYTHON" scripts/test-base-image-resolution.py
"$PYTHON" scripts/test-ssh-deployment.py
"$PYTHON" scripts/test-jq-programs.py
bash scripts/test-deploy-ec2.sh
bash scripts/test-backup-upload-failure.sh
bash scripts/test-certificate-reconciliation.sh
bash scripts/test-operation-locks.sh
"$PYTHON" scripts/test-deploy-first-retry.py
"$PYTHON" scripts/test-release-manifest.py
"$PYTHON" scripts/test-verify-test-results.py

"$DOTNET" restore "$SOLUTION" --locked-mode
"$DOTNET" build "$SOLUTION" -warnaserror --no-restore

if [[ ${SMARTCAMPUS_REQUIRE_SQL_TESTS:-false} == true ]]; then
  "$DOTNET" test tests/SmartCampus.UnitTests/SmartCampus.UnitTests.csproj \
    --no-build --results-directory "$results_dir/unit" --logger 'trx;LogFileName=unit.trx'
  "$DOTNET" test tests/SmartCampus.IntegrationTests/SmartCampus.IntegrationTests.csproj \
    --no-build --filter 'Category!=SqlIntegration' \
    --results-directory "$results_dir/integration" --logger 'trx;LogFileName=integration.trx'
  "$DOTNET" test tests/SmartCampus.IntegrationTests/SmartCampus.IntegrationTests.csproj \
    --no-build --filter 'Category=SqlIntegration' \
    --results-directory "$results_dir/sql" --logger 'trx;LogFileName=sql.trx'
else
  "$DOTNET" test tests/SmartCampus.UnitTests/SmartCampus.UnitTests.csproj \
    --no-build --results-directory "$results_dir/unit" --logger 'trx;LogFileName=unit.trx'
  "$DOTNET" test tests/SmartCampus.IntegrationTests/SmartCampus.IntegrationTests.csproj \
    --no-build --results-directory "$results_dir/integration" --logger 'trx;LogFileName=integration.trx'
fi

"$PYTHON" scripts/verify-test-results.py "$results_dir" "${SMARTCAMPUS_REQUIRE_SQL_TESTS:-false}"

echo "PASS"
