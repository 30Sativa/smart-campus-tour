# Copy to backend/.env; never commit real values. All commands run from repo root.
COMPOSE_PROJECT_NAME=campustour
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-CU27-ubuntu-22.04
# Express is free for a small production database (10 GB/database).
# Developer is for development/test only; Standard requires a license.
MSSQL_PID=Express
MSSQL_MEMORY_LIMIT_MB=2048
SQLSERVER_MEMORY_LIMIT=2560m
SQLSERVER_CPUS=1.25
API_MEMORY_LIMIT=512m
API_CPUS=0.75
DB_INIT_MEMORY_LIMIT=192m
DB_INIT_CPUS=0.25

# Generate EACH SQL password as Aa1! followed by openssl rand -hex 32.
# App password: 32-128 characters, only letters, digits, !, _ and -.
SQL_SA_PASSWORD=
SQL_APP_PASSWORD=
# Generate with openssl rand -hex 32 (at least 32 UTF-8 bytes).
JWT_SIGNING_KEY=

# DNS name only; exact frontend origin without a trailing slash.
API_HOST=api.example.com
WEB_ORIGIN=https://tour.example.com
API_HTTPS_PORT=443
API_BIND_IP=0.0.0.0
API_ENV_FILE=./deploy/api.env
# Relative paths resolve against backend/docker-compose.yml.
TLS_CERT_PATH=./deploy/certs/fullchain.pem
TLS_KEY_PATH=./deploy/certs/privkey.pem
# Host-owned staging path for SQL backups; uploads go to encrypted off-host storage.
SQL_BACKUP_DIR=/var/lib/campustour/backups
