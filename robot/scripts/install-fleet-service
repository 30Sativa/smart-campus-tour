#!/usr/bin/env bash
# install-fleet-service [--dry-run] [--no-start] [--uninstall]
#
# Installs the systemd USER unit sct-fleet.service (robot/config/systemd/) so fleet_bridge runs from
# boot without SSH (robot/docs/fleet-service.md). No sudo here: starting at boot without a login
# needs lingering, which this script only checks and prints the command for.
# Needs the launcher installed at ~/.local/bin/robot with "robot fleet --service".
set -euo pipefail
dry=0; start=1; uninstall=0
for a in "$@"; do
  case "$a" in
    --dry-run) dry=1 ;; --no-start) start=0 ;; --uninstall) uninstall=1 ;;
    *) echo "usage: install-fleet-service [--dry-run] [--no-start] [--uninstall]" >&2; exit 2 ;;
  esac
done
here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
src="$here/config/systemd/sct-fleet.service"
dst_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
dst="$dst_dir/sct-fleet.service"
launcher="$HOME/.local/bin/robot"
do_() { echo "+ $*"; [ "$dry" = 1 ] || "$@"; }

if [ "$uninstall" = 1 ]; then
  do_ systemctl --user disable --now sct-fleet.service || true
  do_ rm -f "$dst"
  do_ systemctl --user daemon-reload
  exit 0
fi
[ -f "$src" ] || { echo "missing $src" >&2; exit 1; }
[ -x "$launcher" ] || { echo "launcher not installed at $launcher (robot/docs/robot-launcher.md)" >&2; exit 1; }
"$launcher" fleet --help 2>/dev/null | grep -q -- 'status' \
  || { echo "$launcher has no fleet service support: install a launcher release that has it" >&2; exit 1; }
# Validates the profile, the ROS environment and the fleet settings without starting anything.
"$launcher" fleet --service --dry-run >/dev/null \
  || { echo "\"robot fleet --service --dry-run\" refused: fix the error above first" >&2; exit 1; }
do_ mkdir -p "$dst_dir"
do_ install -m 0644 "$src" "$dst"
do_ systemctl --user daemon-reload
if [ "$start" = 1 ]; then do_ systemctl --user enable --now sct-fleet.service
else do_ systemctl --user enable sct-fleet.service; fi
linger=$(loginctl show-user "$USER" -p Linger --value 2>/dev/null || echo '?')
if [ "$linger" != yes ]; then
  echo "NOTE: lingering is off for $USER: the service starts at the first login and stops after the last one."
  echo "      To start it at boot without SSH, run once:  sudo loginctl enable-linger $USER"
fi
echo "Check: robot fleet status    Logs: robot fleet logs -f"
