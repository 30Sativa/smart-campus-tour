#!/usr/bin/env bash
# stage-runtime <git-ref> [--dest DIR] [--packages "pkg ..."]
#
# Build an immutable runtime overlay from one commit, next to (never over) the overlays
# already in use. The sources are exported with `git archive`, so the install does not
# follow any checkout; it is built without --symlink-install and both src/ and install/
# are made read-only. Nothing running is stopped, restarted or re-sourced.
#
# Use it (one new terminal, after the usual source-minipc):
#     source DIR/install/setup.bash
# Roll back: open a new terminal and source the previous overlay instead (the old
# overlays are untouched). See robot/docs/runtime-deploy.md.
set -euo pipefail
ref=${1:-}; shift || true
dest=; pkgs=
while [[ $# -gt 0 ]]; do
  case $1 in
    --dest) dest=$2; shift 2;;
    --packages) pkgs=$2; shift 2;;
    *) echo "unknown argument $1" >&2; exit 2;;
  esac
done
[[ -n "$ref" ]] || { echo "usage: stage-runtime <git-ref> [--dest DIR] [--packages \"pkg ...\"]" >&2; exit 2; }
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
sha=$(git -C "$repo" rev-parse --verify "$ref^{commit}") || { echo "unknown ref $ref" >&2; exit 2; }
short=${sha:0:10}
dest=${dest:-$HOME/.cache/sct-runtime/$short}
[[ -e "$dest" ]] && { echo "REFUSED: $dest exists; overlays are never rebuilt in place" >&2; exit 2; }
[[ -f /opt/ros/humble/setup.bash ]] || { echo "ROS 2 Humble is not installed" >&2; exit 1; }

mkdir -p "$dest/src"
git -C "$repo" archive "$sha" robot/ros2_ws/src | tar -x -C "$dest/src" --strip-components=3
set +u
unset AMENT_PREFIX_PATH COLCON_PREFIX_PATH CMAKE_PREFIX_PATH ROS_PACKAGE_PATH
source /opt/ros/humble/setup.bash
set -u
select=()
[[ -n "$pkgs" ]] && select=(--packages-up-to $pkgs)
( cd "$dest" && colcon build --base-paths src --build-base build --install-base install --event-handlers console_direct- \
    --cmake-args -DCMAKE_BUILD_TYPE=Release "${select[@]}" > build.log 2>&1 ) \
  || { echo "BUILD FAILED, see $dest/build.log (the directory is left for inspection, not used by anything)" >&2; exit 1; }
{
  echo "ref: $ref"
  echo "commit: $sha"
  echo "describe: $(git -C "$repo" describe --tags --always "$sha")"
  echo "built: $(date -Iseconds) on $(hostname)"
  echo "packages: $(ls "$dest/install" | grep -v -E '\.(bash|sh|zsh|ps1|py)$|COLCON_IGNORE' | tr '\n' ' ')"
} > "$dest/PROVENANCE"
rm -rf "$dest/build"
chmod -R a-w "$dest/src" "$dest/install"
cat "$dest/PROVENANCE"
echo
echo "Staged, not in use. In a NEW terminal: source robot/scripts/source-minipc; source $dest/install/setup.bash"
echo "Then: python3 robot/scripts/runtime_provenance.py --ref $sha --strict"
