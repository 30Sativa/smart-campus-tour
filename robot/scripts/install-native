#!/usr/bin/env bash
# Provision native ROS dependencies; run explicitly on the miniPC.
set -euo pipefail
ROBOT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source /etc/os-release
if [[ "$ID" != ubuntu || "$VERSION_ID" != 22.04 || ! -f /opt/ros/humble/setup.bash ]]; then
  echo 'Requires Ubuntu 22.04, ROS 2 Humble apt repositories and ros-base installed.' >&2
  exit 1
fi
unset AMENT_PREFIX_PATH COLCON_PREFIX_PATH CMAKE_PREFIX_PATH ROS_PACKAGE_PATH
set +u
source /opt/ros/humble/setup.bash
set -u
sudo apt-get update
sudo apt-get install -y --no-install-recommends \
  build-essential cmake git python3-colcon-common-extensions python3-rosdep \
  python3-venv python3-pip python3-yaml python3-pytest \
  ros-humble-ros-base ros-humble-ros2cli-common-extensions ros-humble-rosbag2 \
  ros-humble-rmw-fastrtps-cpp ros-humble-tf2-tools fastdds-tools
if [[ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]]; then
  sudo rosdep init
fi
rosdep update --rosdistro humble
# Manifests are authoritative. Skip only optional simulation/model-viewer keys.
rosdep install --from-paths "$ROBOT_ROOT/ros2_ws/src" --ignore-src \
  --rosdistro humble -y \
  --skip-keys 'gazebo_ros gazebo_ros2_control gazebo_msgs controller_manager diff_drive_controller joint_state_broadcaster joint_state_publisher_gui'
# Optional person-perception runtime is pinned separately from ROS apt packages.
python3 -m pip install --user --requirement "$ROBOT_ROOT/config/perception-requirements.txt"
echo 'Build: robot/scripts/build-native. Optional Astra/OpenVINO: robot/docs/native-runtime.md.'
