#!/usr/bin/env python3
"""Read-only check that the robot's DDS graph is closed to the network.

Run on the robot after `source robot/scripts/source-minipc`, with the stack
up, before every test run (robot/docs/dds-isolation.md):

    robot/scripts/check-dds-isolation

FAIL lines mean a laptop (or anyone on the campus network) could join or
slow down the robot's DDS graph. Exit 0 = no FAIL, 1 = FAIL, 2 = cannot check.
Changes nothing; only reads the environment, /proc and `ss`.
"""
import os
import re
import subprocess
import sys

LOOPBACK = ('127.', '::1', '[::1]')
SS_PROC = re.compile(r'\("([^"]+)",pid=(\d+)')


def parse_ss(text):
    """`ss -H -[u|t]anp` lines -> [(local_addr, port, [(name, pid)])]."""
    out = []
    for line in text.splitlines():
        cols = line.split()
        if len(cols) < 5:
            continue
        local = cols[3]
        addr, _, port = local.rpartition(':')
        addr = addr.split('%')[0].strip('[]')
        procs = [(n, int(p)) for n, p in SS_PROC.findall(line)]
        out.append((addr, port, procs))
    return out


def is_loopback(addr):
    return addr.startswith(LOOPBACK) or addr == '::1'


def is_multicast(addr):
    if addr.lower().startswith('ff'):
        return True
    first = addr.split('.', 1)[0]
    return first.isdigit() and 224 <= int(first) <= 239


def dds_pids(proc='/proc'):
    """PIDs (readable by us) that have Fast DDS loaded."""
    pids = {}
    for d in os.listdir(proc):
        if not d.isdigit():
            continue
        try:
            with open(f'{proc}/{d}/maps') as f:
                if 'libfastrtps' not in f.read():
                    continue
            with open(f'{proc}/{d}/comm') as f:
                pids[int(d)] = f.read().strip()
        except OSError:
            continue
    return pids


def check_env(env):
    res = []
    lo = env.get('ROS_LOCALHOST_ONLY')
    res.append(('PASS' if lo == '1' else 'FAIL',
                f'ROS_LOCALHOST_ONLY={lo!r} in this shell (robot/.env must set 1)'))
    servers = [s for s in env.get('ROS_DISCOVERY_SERVER', '').split(';') if s]
    loopback = ('127.0.0.1', 'localhost', '::1')
    bad = [s for s in servers if s.rsplit(':', 1)[0].strip('[]') not in loopback]
    if not servers:
        res.append(('FAIL', 'ROS_DISCOVERY_SERVER is not set '
                            '(robot/.env must set 127.0.0.1:11811)'))
    elif bad:
        res.append(('FAIL', f'ROS_DISCOVERY_SERVER has non-loopback entries {bad}'))
    else:
        res.append(('PASS', f'ROS_DISCOVERY_SERVER={";".join(servers)} (loopback)'))
    if lo == '1' and bad:
        res.append(('FAIL', 'LOCALHOST_ONLY=1 with a non-loopback discovery server: '
                            'robot nodes cannot discover each other at all'))
    return res


def check_sockets(udp, tcp, pids):
    """udp/tcp: parse_ss output. pids: {pid: comm} of Fast DDS processes."""
    res = []
    server = [(a, p) for a, p, procs in udp for n, _ in procs if n.startswith('fast-discovery')]
    if not server:
        res.append(('WARN', 'no fast-discovery-server socket visible '
                            '(not running, or another user)'))
    else:
        exposed = [f'{a}:{p}' for a, p in server if not is_loopback(a)]
        if exposed:
            res.append(('FAIL', f'discovery server listens on {exposed}: run it with '
                                'config/fastdds/discovery_server_loopback.xml (step S3; '
                                '`-l 127.0.0.1` alone still binds 0.0.0.0)'))
        else:
            res.append(('PASS', f'discovery server on loopback only ({len(server)} sockets)'))
    exposed = {}
    for a, p, procs in udp:
        for n, pid in procs:
            if pid not in pids or n.startswith('fast-discovery'):
                continue
            if not is_loopback(a) and not is_multicast(a):
                exposed.setdefault(f'{pids[pid]}[{pid}]', []).append(f'{a}:{p}')
    if exposed:
        for proc, socks in sorted(exposed.items()):
            res.append(('FAIL', f'{proc} has DDS sockets off loopback: {socks[:4]}'))
    else:
        nodes = [c for c in pids.values() if not c.startswith('fast-discovery')]
        res.append(('PASS', f'{len(nodes)} Fast DDS processes, all sockets on loopback'))
    bridge = [(a, p) for a, p, procs in tcp for n, _ in procs if n.startswith('foxglove')]
    if bridge:
        open_ = [f'{a}:{p}' for a, p in bridge if not is_loopback(a)]
        if open_:
            res.append(('FAIL', f'foxglove_bridge listens on {open_}: '
                                'anyone on the network can connect'))
        else:
            res.append(('PASS', 'foxglove_bridge listens on loopback only'))
    return res


def check_host(sshd_config='/etc/ssh/sshd_config'):
    res = []
    try:
        # sshd keeps the first value; Ubuntu includes sshd_config.d/*.conf at
        # the top of sshd_config, so those files win.
        text = ''
        d = sshd_config + '.d'
        for extra in sorted(os.listdir(d)) if os.path.isdir(d) else []:
            try:
                text += open(os.path.join(d, extra)).read() + '\n'
            except OSError:
                pass
        text += open(sshd_config).read()
        m = re.search(r'^\s*PasswordAuthentication\s+(\w+)', text, re.M | re.I)
        if not m or m.group(1).lower() != 'no':
            res.append(('WARN', 'sshd allows password logins: the SSH tunnel is the only door '
                                'to the robot, prefer keys only (PasswordAuthentication no)'))
        else:
            res.append(('PASS', 'sshd: keys only'))
    except OSError:
        res.append(('WARN', f'cannot read {sshd_config}'))
    return res


def ss(flags):
    return subprocess.run(['ss', '-H', flags], capture_output=True, text=True, check=True).stdout


def main():
    try:
        udp, tcp = parse_ss(ss('-uanp')), parse_ss(ss('-tlnp'))
    except (OSError, subprocess.CalledProcessError) as e:
        print(f'cannot run ss: {e}')
        return 2
    pids = dds_pids()
    results = check_env(os.environ) + check_sockets(udp, tcp, pids) + check_host()
    if not [c for c in pids.values() if not c.startswith('fast-discovery')]:
        results.append(('WARN', 'no Fast DDS process running: start the stack, then re-run'))
    for level, text in results:
        print(f'{level:4s}  {text}')
    fails = sum(level == 'FAIL' for level, _ in results)
    print(f'\n{"ISOLATED" if not fails else "NOT ISOLATED"}: {fails} FAIL, '
          f'{sum(level == "WARN" for level, _ in results)} WARN')
    return 1 if fails else 0


if __name__ == '__main__':
    sys.exit(main())
