#!/usr/bin/env python3
"""robot: start the real robot's workflows, each process with its own environment.

The calling shell does not matter: every command builds its environment from a clean
base, the machine profile (~/.config/sct-robot/runtime.env), the robot .env through
robot/scripts/source-minipc, and at most ONE overlay. Nothing here edits a shell
startup file, an overlay or a symlink. See robot/docs/robot-launcher.md.

  robot status                      read-only: profile, runtime, calibration, processes, logs
  robot env | shell                 print the environment / open a shell with it
  robot manual | map | nav          start one workflow (refused while another runs)
  robot nav --fleet                 NAV2 with the ADR-0049 motion gate (require_motion_permit)
  robot fleet [--commands]          fleet_bridge: telemetry; --commands also takes Tours from the
                                    backend, only beside a 'robot nav --fleet' session
  robot reset-latch                 clear the motion gate latch (a person decides it is safe)
  robot teleop                      keyboard teleop for the running workflow
  robot stop                        SOFTWARE stop key (not the hardware E-stop)
  robot preflight <workflow> [--static]
  robot record start|stop [DIR]
  robot lidar-check ...             static wall check of the CANDIDATE LiDAR yaw
  robot calibration accept DIR [--yes]
  robot logs [prune [--yes]]
--dry-run on manual/map/nav/teleop/stop/preflight/record/lidar-check prints the command
and environment and starts nothing. status, env and --dry-run never talk to ROS.
"""
import argparse
import datetime as dt
import fcntl
import json
import math
import os
import re
import shutil
import subprocess
import sys
import time

ROBOT_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))   # robot/ holding these tools
PROFILE = os.environ.get('SCT_ROBOT_PROFILE', os.path.expanduser('~/.config/sct-robot/runtime.env'))
STATE_DIR = os.environ.get('SCT_ROBOT_STATE', os.path.expanduser('~/.local/state/sct-robot'))
PROC = os.environ.get('SCT_PROC_ROOT', '/proc')
USB = os.environ.get('SCT_USB_ROOT', '/sys/bus/usb/devices')
ROS_SETUP = '/opt/ros/humble'
WORKFLOWS = ('manual', 'map', 'nav')
# LiDAR yaw values that ran on the robot as a recorded baseline. Having run is not
# having been checked: these are 'legacy_baseline', enough for MANUAL (no LiDAR consumer)
# but not for BUILD MAP or NAV2, which need 'validated' (a PASS static check as evidence).
LEGACY_BASELINE_LIDAR_YAWS = {'robot-baseline-20261102': -3.0695}
# Project demo: the state is reported and warned about, it does not block a workflow.
CALIBRATION_ALLOWS = {w: ('validated', 'legacy_baseline', 'unverified') for w in ('manual', 'map', 'nav')}
TELEOP_LIMITS = {'TELEOP_SPEED': 0.30, 'TELEOP_TURN': 1.00}        # m/s, rad/s hard caps
PROFILE_KEYS = {
    'SCT_ROBOT_ROOT': None, 'SCT_OVERLAY': '', 'ROBOT_ID': None,
    'LIDAR_YAW': None, 'LIDAR_YAW_EVIDENCE': '', 'LIDAR_YAW_CANDIDATE': '', 'LIDAR_YAW_PREVIOUS': '',
    'MAP': 'map2.yaml', 'NAV2_PARAMS': 'nav2_params_v2.yaml', 'MAP_MAX_WHEEL_SPEED_MM_S': '250.0',
    'TELEOP_SPEED': '0.1', 'TELEOP_TURN': '0.3',
    'FLEET_ENV_FILE': '~/.config/campustour/fleet-sync.env',
    'FOXGLOVE_ENV': '~/.local/opt/foxglove-bridge-3.6.0/env.sh',
    # Project demo: a 2D Pose Estimate alone counts as localized (RViz sets 0.25 m^2 / 0.0685 rad^2).
    # fleet_bridge's own defaults (0.09 / 0.05) need the robot driven a little after the pose.
    'LOCALIZED_MAX_XY_VARIANCE': '0.3', 'LOCALIZED_MAX_YAW_VARIANCE': '0.1',
    # One HTTPS request to the backend takes about 1 s from the lab; a leg start posts its result and
    # then polls, so the fleet_bridge default of 1.5 s cut legs as link loss (13/11/2026). Campus Wi-Fi
    # roaming drops the link for a few seconds while the robot drives; the backend sets
    # FleetCommands:MaxTelemetryAgeSeconds 10 to match.
    'MOTION_PERMIT_LINK_TIMEOUT_SEC': '20.0',
    # nav: pose_bootstrap sets the initial pose from the LiDAR (robot/docs/auto-initial-pose.md).
    # Off by default; "robot nav --auto-pose" / "--manual-pose" override it per run.
    'AUTO_INITIAL_POSE': 'false',
    # nav: Astra Pro depth into the LOCAL costmap only, beside the LiDAR (robot/docs/depth-camera.md).
    # Off by default; "robot nav --camera" / "--no-camera" override it per run.
    'ENABLE_CAMERA': 'false',
    # fleet service (robot/docs/fleet-service.md): auto = commands exactly while "robot nav --fleet" runs
    # (the ADR-0049 motion gate is up), telemetry otherwise; off = telemetry only, always.
    'FLEET_SERVICE_COMMANDS': 'auto',
    'SCT_LOG_ROOT': '~/amr_logs/runs', 'LOG_KEEP_DAYS': '30', 'LOG_MAX_MB': '2000', 'MIN_FREE_GB': '5',
}
NODE_PATTERNS = {
    'stm32_bridge_node': r'stm32_bridge_node', 'mode_manager_node': r'mode_manager_node',
    'ekf_node': r'/ekf_node( |$)', 'robot_state_publisher': r'/robot_state_publisher( |$)',
    'rplidar_node': r'/rplidar_node( |$)', 'slam_toolbox': r'async_slam_toolbox_node',
    'amcl': r'/nav2_amcl/amcl( |$)', 'controller_server': r'/controller_server( |$)',
    'frontier_explorer': r'simple_frontier_explorer',
}
COMMAND_SOURCES = {'teleop_keyboard': r'teleop_twist_keyboard', 'teleop_joy': r'/teleop_node( |$)'}
OTHER = {'bag_record': r'ros2 bag record', 'stopkey': r'stopkey\.py', 'preflight': r'preflight\.py',
         # telemetry by default; with commands_enabled it is a second navigation-goal owner
         'fleet_bridge': r'/fleet_bridge/fleet_bridge( |$)',
         'viewer_bridge': r'foxglove_bridge|debug_bridge\.launch\.py'}


class Refused(Exception):
    pass


# ---- profile ----------------------------------------------------------------------
def load_profile(path=PROFILE):
    if not os.path.isfile(path):
        raise Refused(f'no profile at {path}; copy robot/config/runtime.env.example there and edit it')
    values = {}
    for n, raw in enumerate(open(path, encoding='utf-8'), 1):
        line = raw.strip()
        if not line or line.startswith('#'):
            continue
        m = re.fullmatch(r'([A-Z0-9_]+)=(.*)', line)
        if not m:
            raise Refused(f'{path}:{n}: expected KEY=VALUE, got {line!r}')
        key, value = m.group(1), m.group(2).strip()
        if key not in PROFILE_KEYS:
            raise Refused(f'{path}:{n}: unknown key {key} (typo?)')
        if len(value) >= 2 and value[0] == value[-1] and value[0] in '"\'':
            value = value[1:-1]
        values[key] = os.path.expanduser(value.replace('$HOME', os.path.expanduser('~')))
    for key, default in PROFILE_KEYS.items():
        if key not in values:
            if default is None:
                raise Refused(f'{path}: {key} is required')
            values[key] = os.path.expanduser(default)
    p = values
    if not re.fullmatch(r'[a-z][a-z0-9_]*', p['ROBOT_ID']):
        raise Refused(f'ROBOT_ID {p["ROBOT_ID"]!r} is not a ROS name')
    for key in ('LIDAR_YAW', 'MAP_MAX_WHEEL_SPEED_MM_S', 'TELEOP_SPEED', 'TELEOP_TURN', 'LOG_KEEP_DAYS',
                'LOG_MAX_MB', 'MIN_FREE_GB'):
        try:
            float(p[key])
        except ValueError:
            raise Refused(f'{key}={p[key]!r} is not a number') from None
    for key, cap in TELEOP_LIMITS.items():
        if not 0 < float(p[key]) <= cap:
            raise Refused(f'{key}={p[key]} outside (0, {cap}]')
    if not 0 < float(p['MAP_MAX_WHEEL_SPEED_MM_S']) <= 350:
        raise Refused('MAP_MAX_WHEEL_SPEED_MM_S must be in (0, 350]')
    return p


def angle_equal(a, b, tol=1e-4):
    d = float(a) - float(b)
    return abs(math.atan2(math.sin(d), math.cos(d))) < tol


def read_verdict(directory):
    path = os.path.join(directory, 'verdict.txt')
    if not os.path.isfile(path):
        raise Refused(f'{path} not found (static_lidar_check.sh writes it)')
    v = dict(line.split('=', 1) for line in open(path).read().split() if '=' in line)
    return v


def calibration(p):
    """(state, explanation): state is 'validated', 'legacy_baseline' or 'unverified'."""
    yaw = float(p['LIDAR_YAW'])
    if p['LIDAR_YAW_EVIDENCE']:
        try:
            v = read_verdict(p['LIDAR_YAW_EVIDENCE'])
        except Refused as exc:
            return 'unverified', f'LIDAR_YAW {yaw} cites evidence that cannot be read: {exc}'
        if v.get('verdict') != 'PASS' or v.get('tf_ok') != 'True':
            return 'unverified', f'evidence {p["LIDAR_YAW_EVIDENCE"]} is {v.get("verdict")}, not PASS'
        if not angle_equal(v.get('candidate_rad', 'nan'), yaw):
            return 'unverified', f'evidence was measured for {v.get("candidate_rad")}, profile says {yaw}'
        return 'validated', f'static wall check PASS ({p["LIDAR_YAW_EVIDENCE"]}, difference {v.get("difference_deg")} deg)'
    for tag, value in LEGACY_BASELINE_LIDAR_YAWS.items():
        if angle_equal(value, yaw):
            return 'legacy_baseline', f'ran as {tag}; never checked (offline analysis puts it about 5 deg off)'
    return 'unverified', (f'LIDAR_YAW {yaw} is neither a legacy baseline value nor backed by a PASS static check '
                          f'(set LIDAR_YAW_EVIDENCE through "robot calibration accept")')


def resolve_data(p):
    root = p['SCT_ROBOT_ROOT']
    m = p['MAP'] if os.path.isabs(p['MAP']) else os.path.join(root, 'robot_maps', p['MAP'])
    n = p['NAV2_PARAMS'] if os.path.isabs(p['NAV2_PARAMS']) else \
        os.path.join(root, 'ros2_ws', 'src', 'robot_control', 'config', p['NAV2_PARAMS'])
    return m, n


# ---- environment --------------------------------------------------------------------
def clean_base_env():
    keep = ('HOME', 'USER', 'LOGNAME', 'SHELL', 'LANG', 'TERM', 'DISPLAY', 'XAUTHORITY', 'XDG_RUNTIME_DIR',
            'DBUS_SESSION_BUS_ADDRESS', 'SSH_AUTH_SOCK')
    env = {k: v for k, v in os.environ.items() if k in keep or k.startswith('LC_')}
    env['PATH'] = '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    return env


def build_env(p):
    """Environment of one robot process. Raises Refused with the reason."""
    root, overlay = p['SCT_ROBOT_ROOT'], p['SCT_OVERLAY']
    helper = os.path.join(ROBOT_DIR, 'scripts', 'source-minipc')
    for what, path in (('SCT_ROBOT_ROOT/.env', os.path.join(root, '.env')),
                       ('base install', os.path.join(root, 'ros2_ws', 'install', 'setup.bash')),
                       ('ROS 2 Humble', os.path.join(ROS_SETUP, 'setup.bash'))):
        if not os.path.isfile(path):
            raise Refused(f'{what} missing: {path}')
    if overlay and not os.path.isfile(os.path.join(overlay, 'setup.bash')):
        raise Refused(f'SCT_OVERLAY has no setup.bash: {overlay}')
    script = ('export ROBOT_RUNTIME_ROOT="$1"; source "$2" >/dev/null || exit 3; '
              'if [ -n "$3" ]; then source "$3/setup.bash" || exit 4; fi; env -0')
    r = subprocess.run(['bash', '--noprofile', '--norc', '-c', script, 'robot-env', root, helper, overlay],
                       env=clean_base_env(), capture_output=True, timeout=60)
    if r.returncode != 0:
        raise Refused(f'environment setup failed ({r.returncode}): {r.stderr.decode(errors="replace").strip()}')
    env = dict(kv.split('=', 1) for kv in r.stdout.decode(errors='replace').split('\0') if '=' in kv)
    env.pop('ROS_SUPER_CLIENT', None)
    for key in ('ROS_DOMAIN_ID', 'RMW_IMPLEMENTATION', 'ROS_DISCOVERY_SERVER'):
        if not env.get(key):
            raise Refused(f'{key} not set by {root}/.env')
    allowed = [os.path.realpath(x) for x in (ROS_SETUP, os.path.join(root, 'ros2_ws', 'install'), overlay) if x]
    for prefix in env.get('AMENT_PREFIX_PATH', '').split(':'):
        if prefix and not any(os.path.realpath(prefix) == a or os.path.realpath(prefix).startswith(a + os.sep)
                              for a in allowed):
            raise Refused(f'AMENT_PREFIX_PATH has {prefix}, outside ROS, the base install and SCT_OVERLAY '
                          '(the overlay chains to another workspace?)')
    return env


def package_prefix(env, pkg):
    for prefix in env.get('AMENT_PREFIX_PATH', '').split(':'):
        if prefix and os.path.exists(os.path.join(prefix, 'share', 'ament_index', 'resource_index', 'packages', pkg)):
            return prefix
    return None


# ---- processes ----------------------------------------------------------------------
def start_ticks(pid, proc=PROC):
    """Kernel start time of a process (clock ticks since boot), or None. With the pid it
    identifies one process even after the pid is reused."""
    try:
        stat = open(os.path.join(proc, str(pid), 'stat')).read()
        return int(stat.rsplit(')', 1)[1].split()[19])
    except (OSError, ValueError, IndexError):
        return None


def scan_processes(proc=PROC):
    """Own-user processes that matter, with domain and namespace."""
    found = []
    uid = os.getuid()
    for pid in filter(str.isdigit, os.listdir(proc)):
        base = os.path.join(proc, pid)
        try:
            if os.stat(base).st_uid != uid or int(pid) == os.getpid():
                continue
            raw = open(os.path.join(base, 'cmdline'), 'rb').read()
            args = [x.decode(errors='replace') for x in raw.split(b'\0') if x]
            cmd = ' '.join(args)
        except (OSError, ValueError):
            continue
        if not cmd or re.search(r'(^|/)robot (status|env)', cmd):
            continue
        # `ros2 run` wrappers repeat the executable name; count the real binaries
        if re.match(r'^\S*python3 \S*/ros2 run ', cmd):
            continue
        for group in (NODE_PATTERNS, COMMAND_SOURCES, OTHER):
            for name, pat in group.items():
                if re.search(pat, cmd):
                    try:
                        environ = open(os.path.join(base, 'environ'), 'rb').read().split(b'\0')
                        envd = dict(x.decode(errors='replace').split('=', 1) for x in environ if b'=' in x)
                    except OSError:
                        envd = {}
                    ns = re.search(r'__ns:=(\S+)', cmd)
                    found.append(dict(pid=int(pid), name=name, domain=envd.get('ROS_DOMAIN_ID'),
                                      namespace=ns.group(1) if ns else None, cmd=cmd[:160], args=args))
    return found


def fleet_bridge_commands(entry):
    """commands_enabled of a running fleet_bridge from its --params-file files and -p overrides
    (True, False or None when it cannot be told), applied in command-line order as ROS does."""
    try:
        import yaml
    except ImportError:
        return None
    args = entry.get('args', [])
    value, known = False, False                        # the node's declared default
    for i, x in enumerate(args[:-1]):
        if x == '--params-file':
            try:
                data = yaml.safe_load(open(args[i + 1])) or {}
            except (OSError, yaml.YAMLError):
                return None                            # a file we cannot read may set it
            known = True
            for node in data.values() if isinstance(data, dict) else []:
                params = (node or {}).get('ros__parameters', {}) if isinstance(node, dict) else {}
                if 'commands_enabled' in params:
                    value = params['commands_enabled']
        elif x == '-p' and args[i + 1].startswith('commands_enabled:='):
            known = True
            value = {'true': True, 'false': False}.get(args[i + 1].split(':=', 1)[1].strip().lower(), None)
    if not known:
        return None
    return value if isinstance(value, bool) else None


def robot_nodes(procs):
    return [x for x in procs if x['name'] in NODE_PATTERNS]


# ---- lock and sessions --------------------------------------------------------------
def lock_info(name):
    """Contents of a held lock, or None. Probes with a shared lock on a read-only fd, so it
    never writes and a stale file (holder gone) reads as free."""
    path = os.path.join(STATE_DIR, name + '.lock')
    try:
        fd = os.open(path, os.O_RDONLY)
    except FileNotFoundError:
        return None
    try:
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        fcntl.flock(fd, fcntl.LOCK_UN)
        return None
    except BlockingIOError:
        try:
            return json.loads(os.read(fd, 65536) or b'{}')
        except ValueError:
            return {'workflow': '?'}
    finally:
        os.close(fd)


def take_lock(name, info):
    os.makedirs(STATE_DIR, exist_ok=True)
    path = os.path.join(STATE_DIR, name + '.lock')
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        raise Refused(f'{name} lock held: {json.dumps(lock_info(name))}') from None
    os.ftruncate(fd, 0)
    os.write(fd, json.dumps(info).encode())
    os.set_inheritable(fd, True)                       # the exec'd launch keeps holding it
    return fd


def log_root(p):
    return os.path.expanduser(p['SCT_LOG_ROOT'])


def new_session(p, workflow):
    root = log_root(p)
    os.makedirs(root, exist_ok=True)
    stamp = dt.datetime.now().strftime('%Y%m%d_%H%M%S')
    path = os.path.join(root, f'{stamp}_{workflow}')
    os.makedirs(os.path.join(path, 'ros_log'))         # fails if it exists: one directory per session
    open(os.path.join(path, '.sct-session'), 'w').close()
    return path


def sessions(p):
    root = log_root(p)
    out = []
    if not os.path.isdir(root):
        return out
    for name in sorted(os.listdir(root)):
        d = os.path.join(root, name)
        if not os.path.isfile(os.path.join(d, '.sct-session')):
            continue                                   # never touch directories the launcher did not create
        info = {}
        try:
            info = json.load(open(os.path.join(d, 'session.json')))
        except (OSError, ValueError):
            pass
        logs = os.path.join(d, 'ros_log')
        size = sum(os.path.getsize(os.path.join(a, f)) for a, _, fs in os.walk(logs) for f in fs) if os.path.isdir(logs) else 0
        pid = info.get('pid')
        # a pid alone can be reused by an unrelated process; the start time must match too
        alive = bool(pid) and start_ticks(pid) is not None and start_ticks(pid) == info.get('start_ticks')
        out.append(dict(dir=d, size=size, mtime=os.path.getmtime(d), alive=alive, has_logs=os.path.isdir(logs)))
    return out


def tool_log_dir(p, tool, dry_run):
    """ROS_LOG_DIR for a helper process: inside the running workflow's session, else its own."""
    held = lock_info('workflow') or {}
    if held.get('session'):
        return os.path.join(held['session'], f'ros_log_{tool}')
    if dry_run:
        return f'(new {tool} session)/ros_log'
    return os.path.join(new_session(p, tool), 'ros_log')


def free_gb(path):
    while not os.path.exists(path):
        path = os.path.dirname(path)
    return shutil.disk_usage(path).free / 1e9


# ---- commands -----------------------------------------------------------------------
def env_diff(env):
    shown = ('ROS_DOMAIN_ID', 'RMW_IMPLEMENTATION', 'ROS_DISCOVERY_SERVER', 'ROS_LOCALHOST_ONLY', 'ROS_SUPER_CLIENT',
             'ROS_LOG_DIR', 'ROBOT_MAP_DIR', 'AMENT_PREFIX_PATH')
    return {k: env[k] for k in shown if k in env}


def workflow_argv(p, workflow, fleet=False, auto_pose=False, camera=False):
    m, n = resolve_data(p)
    base = [f'robot_id:={p["ROBOT_ID"]}', f'lidar_yaw:={p["LIDAR_YAW"]}']
    if workflow == 'manual':
        return ['ros2', 'launch', 'robot_control', 'manual_mode.launch.py', *base]
    if workflow == 'map':
        return ['ros2', 'launch', 'robot_control', 'manual_mapping.launch.py', *base,
                f'max_wheel_speed_mm_s:={p["MAP_MAX_WHEEL_SPEED_MM_S"]}', 'rviz:=false']
    return ['ros2', 'launch', 'robot_navigation', 'navigation.launch.py', *base, f'map:={m}',
            f'enable_camera:={str(camera).lower()}', 'rviz:=false', f'nav2_params_file:={n}'] + \
        (['require_motion_permit:=true'] if fleet else []) + (['auto_initial_pose:=true'] if auto_pose else [])


def auto_pose_wanted(p, a):
    if getattr(a, 'auto_pose', False):
        return True
    if getattr(a, 'manual_pose', False):
        return False
    return p['AUTO_INITIAL_POSE'].strip().lower() in ('1', 'true', 'yes', 'on')


def camera_wanted(p, a):
    if getattr(a, 'camera', False):
        return True
    if getattr(a, 'no_camera', False):
        return False
    return p['ENABLE_CAMERA'].strip().lower() in ('1', 'true', 'yes', 'on')


ASTRA_DEPTH_USB = ('2bc5', '0403')       # Orbbec Astra Pro depth (OpenNI); the RGB half is 2bc5:0501


def camera_problem(env):
    """Why the depth camera cannot join this nav session, or None. The camera is supplementary
    (ADR-0001): the caller falls back to LiDAR-only instead of refusing nav."""
    if not package_prefix(env, 'astra_camera'):
        return 'astra_camera (the Astra driver) is not installed in this ROS environment'
    lean = share_file(env, 'orbbec_bringup', 'launch', 'astra_pro.launch.py')
    if not lean or 'use_uvc_camera' not in open(lean).read():
        return ('this runtime predates the 14/11 camera settings (CAD mount, depth-only driver): '
                'stage a newer overlay')
    for dev in (os.listdir(USB) if os.path.isdir(USB) else []):
        try:
            ids = tuple(open(os.path.join(USB, dev, f)).read().strip() for f in ('idVendor', 'idProduct'))
        except OSError:
            continue
        if ids == ASTRA_DEPTH_USB:
            return None
    return f'no Astra depth device ({":".join(ASTRA_DEPTH_USB)}) on USB: plug it in, or check lsusb'


def check_auto_pose_runtime(env, map_yaml):
    nav_launch = share_file(env, 'robot_navigation', 'launch', 'navigation.launch.py')
    if not nav_launch or 'auto_initial_pose' not in open(nav_launch).read():
        raise Refused('this runtime has no pose_bootstrap (navigation.launch.py lacks auto_initial_pose): stage an '
                      'overlay that has it, or run "robot nav --manual-pose"')
    cfg = os.path.splitext(map_yaml)[0] + '.pose_bootstrap.yaml'
    if not os.path.isfile(cfg):
        raise Refused(f'no {os.path.basename(cfg)} next to the map: auto pose needs per-map settings '
                      '(robot/docs/auto-initial-pose.md), or run "robot nav --manual-pose"')


FLEET_ENV_KEYS = ('FLEET_SYNC_URL', 'FLEET_ROBOT_CODE', 'FLEET_ROBOT_MAP_KEY', 'FLEET_ROBOT_FRAME_ID',
                  'FLEET_ROBOT_CREDENTIAL_FILE')
# Optional: the MapVersion ZIP and its checksum (web: Quản lý bản đồ). Without them the robot
# reports MAP_EVIDENCE_MISSING and never reports motionReady.
FLEET_MAP_KEYS = ('FLEET_MAP_PACKAGE_PATH', 'FLEET_MAP_PACKAGE_SHA256')


def share_file(env, pkg, *rel):
    prefix = package_prefix(env, pkg)
    return os.path.join(prefix, 'share', pkg, *rel) if prefix else None


def check_fleet_runtime(env, commands):
    """The runtime must carry the ADR-0049 gate before a fleet session (smoothws does not)."""
    nav_launch = share_file(env, 'robot_navigation', 'launch', 'navigation.launch.py')
    if not nav_launch or 'require_motion_permit' not in open(nav_launch).read():
        raise Refused('this runtime has no motion gate (navigation.launch.py lacks require_motion_permit); '
                      'stage an overlay from main and point SCT_OVERLAY at it (robot/docs/runtime-deploy.md)')
    if commands:
        prefix = package_prefix(env, 'fleet_bridge')
        found = prefix and any('motion_permit_ros.py' in files for _, _, files in os.walk(os.path.join(prefix, 'lib')))
        if not found:
            raise Refused('fleet_bridge in this runtime has no motion permit publisher (motion_permit_ros.py)')


def read_fleet_env(p):
    """FLEET_* settings for fleet_bridge from the machine file; values are never printed."""
    path = p['FLEET_ENV_FILE']
    if not os.path.isfile(path):
        raise Refused(f'fleet settings not found: {path}')
    values = {}
    for raw in open(path, encoding='utf-8'):
        m = re.fullmatch(r'\s*(?:export\s+)?([A-Z_][A-Z0-9_]*)=(.*)', raw.rstrip('\n'))
        if m and m.group(1) in FLEET_ENV_KEYS + FLEET_MAP_KEYS:
            v = m.group(2).strip()
            if len(v) >= 2 and v[0] == v[-1] and v[0] in '"\'':
                v = v[1:-1]
            values[m.group(1)] = v
    missing = [k for k in FLEET_ENV_KEYS if not values.get(k)]
    if missing:
        raise Refused(f'{path} lacks {", ".join(missing)}')
    if not os.path.isfile(os.path.expanduser(values['FLEET_ROBOT_CREDENTIAL_FILE'])):
        raise Refused('FLEET_ROBOT_CREDENTIAL_FILE does not point to a file')
    if bool(values.get('FLEET_MAP_PACKAGE_PATH')) != bool(values.get('FLEET_MAP_PACKAGE_SHA256')):
        raise Refused(f'{path}: set both FLEET_MAP_PACKAGE_PATH and FLEET_MAP_PACKAGE_SHA256, or neither')
    if values.get('FLEET_MAP_PACKAGE_PATH'):
        values['FLEET_MAP_PACKAGE_PATH'] = os.path.expanduser(values['FLEET_MAP_PACKAGE_PATH'])
        if not os.path.isfile(values['FLEET_MAP_PACKAGE_PATH']):
            raise Refused('FLEET_MAP_PACKAGE_PATH does not point to a file')
        if not re.fullmatch(r'[0-9a-fA-F]{64}', values['FLEET_MAP_PACKAGE_SHA256']):
            raise Refused('FLEET_MAP_PACKAGE_SHA256 is not a 64-character hex checksum')
    return values


def fleet_argv(p, env, values, commands):
    params = share_file(env, 'fleet_bridge', 'config', 'fleet_bridge.yaml')
    if not params:
        raise Refused('package fleet_bridge not found in this runtime')
    argv = ['ros2', 'run', 'fleet_bridge', 'fleet_bridge', '--ros-args', '-r', f'__ns:=/{p["ROBOT_ID"]}',
            '--params-file', params, '-p', f'backend_url:={values["FLEET_SYNC_URL"]}',
            '-p', f'robot_code:={values["FLEET_ROBOT_CODE"]}', '-p', f'map_key:={values["FLEET_ROBOT_MAP_KEY"]}',
            '-p', f'frame_id:={values["FLEET_ROBOT_FRAME_ID"]}']
    if commands:
        # ADR-0049: commands only together with the motion permit; report period below 2 s.
        argv += ['-p', 'commands_enabled:=true', '-p', 'report_period_sec:=0.5',
                 '-p', f'localized_max_xy_variance:={float(p["LOCALIZED_MAX_XY_VARIANCE"])}',
                 '-p', f'localized_max_yaw_variance:={float(p["LOCALIZED_MAX_YAW_VARIANCE"])}',
                 '-p', f'motion_permit_link_timeout_sec:={float(p["MOTION_PERMIT_LINK_TIMEOUT_SEC"])}']
        if values.get('FLEET_MAP_PACKAGE_PATH'):
            argv += ['-p', f'map_package_path:={values["FLEET_MAP_PACKAGE_PATH"]}',
                     '-p', f'map_package_sha256:={values["FLEET_MAP_PACKAGE_SHA256"].lower()}']
    return argv


def check_workflow(p, env, workflow, procs):
    state, why = calibration(p)
    if state not in CALIBRATION_ALLOWS[workflow]:
        raise Refused(f'calibration: {workflow} does not accept LIDAR_YAW in state {state}: {why}')
    if state != 'validated' and workflow in ('map', 'nav'):
        print(f'WARNING: LIDAR_YAW {p["LIDAR_YAW"]} is {state} ({why}). {workflow} runs anyway; '
              'localization may be a few degrees off.', file=sys.stderr)
    held = lock_info('workflow')
    if held:
        raise Refused(f'workflow {held.get("workflow")} already running (pid {held.get("pid")}, {held.get("session")})')
    running = robot_nodes(procs)
    if running:
        raise Refused('robot processes already running (started outside robot?): ' +
                      ', '.join(f'{x["name"]}[{x["pid"]}]' for x in running))
    m, n = resolve_data(p)
    if workflow == 'nav':
        for what, path in (('map', m), ('NAV2_PARAMS', n)):
            if not os.path.isfile(path):
                raise Refused(f'{what} not found: {path}')
        if not package_prefix(env, 'robot_nav_plugins'):
            raise Refused('robot_nav_plugins is not in this runtime (Nav2 V2 needs LatchedGoalChecker); '
                          'set SCT_OVERLAY to an overlay that has it')
    for fb in (x for x in procs if x['name'] == 'fleet_bridge'):
        commands = fleet_bridge_commands(fb)
        if workflow == 'nav' and commands is not False:
            print(f'WARNING: fleet_bridge[{fb["pid"]}] runs with commands_enabled={commands}: Tours from the web '
                  'will send goals; do not also send goals from RViz or route_test.', file=sys.stderr)
        if workflow == 'nav':
            print(f'note: fleet_bridge[{fb["pid"]}] is telemetry-only (commands_enabled: false)', file=sys.stderr)
    for pkg in ('robot_control', 'stm32_bridge', 'robot_description') + (('robot_navigation',) if workflow == 'nav' else ()):
        if not package_prefix(env, pkg):
            raise Refused(f'package {pkg} not found in this runtime')
    if free_gb(log_root(p)) < float(p['MIN_FREE_GB']):
        raise Refused(f'less than {p["MIN_FREE_GB"]} GB free under {log_root(p)}')


def check_teleop(p, env, procs):
    mm = [x for x in procs if x['name'] == 'mode_manager_node']
    if not mm:
        raise Refused('no mode_manager is running: start "robot manual" or "robot map" first')
    if len(mm) > 1:
        raise Refused(f'{len(mm)} mode_manager processes: two workflows are running')
    if mm[0]['domain'] and mm[0]['domain'] != env['ROS_DOMAIN_ID']:
        raise Refused(f'mode_manager runs on domain {mm[0]["domain"]}, this profile on {env["ROS_DOMAIN_ID"]}')
    want_ns = '/' + p['ROBOT_ID']
    if mm[0]['namespace'] and mm[0]['namespace'] != want_ns:
        raise Refused(f'mode_manager namespace {mm[0]["namespace"]} differs from ROBOT_ID {want_ns}')
    other = [x for x in procs if x['name'] in COMMAND_SOURCES]
    if other or lock_info('teleop'):
        raise Refused('another teleop is already running: ' + ', '.join(f'{x["name"]}[{x["pid"]}]' for x in other))



# ---- fleet service ----------------------------------------------------------------------
# One supervised fleet_bridge for the whole uptime of the MiniPC (robot/docs/fleet-service.md).
# systemd (user unit sct-fleet.service) starts "robot fleet --service" at boot and restarts it;
# this loop owns the bridge: telemetry always (the backend sees the robot online without Nav2),
# commands only while "robot nav --fleet" holds the workflow lock (the ADR-0049 motion gate is up).
# The bridge already retries the backend on its own; this loop only restarts it when it exits or
# when the wanted mode changes.
FLEET_UNIT = 'sct-fleet.service'
FLEET_STATUS = 'fleet-service.json'
SYNC_LINES = (('Fleet Sync acknowledged', 'connected'), ('Fleet Sync retry/recovery', 'retrying'),
              ('Fleet Sync paused', 'waiting_clock'), ('Fleet Sync stopped', 'fatal'),
              ('configuration error', 'config_error'))


def fleet_wanted_commands(p):
    """(commands?, why) from the profile and the running workflow."""
    if p['FLEET_SERVICE_COMMANDS'].strip().lower() == 'off':
        return False, 'FLEET_SERVICE_COMMANDS=off'
    held = lock_info('workflow') or {}
    if held.get('workflow') == 'nav' and held.get('fleet'):
        return True, f'robot nav --fleet running (pid {held.get("pid")})'
    return False, 'no "robot nav --fleet" session'


def write_status(path, data):
    tmp = path + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(data, f, indent=1)
    os.replace(tmp, path)


def fleet_service(p, env):
    """Foreground supervisor, run by systemd. Returns only on SIGTERM/SIGINT."""
    import signal
    import threading
    fd = take_lock('fleet', dict(service=True, pid=os.getpid()))
    session = new_session(p, 'fleet_service')
    status_path = os.path.join(STATE_DIR, FLEET_STATUS)
    bmin = float(os.environ.get('SCT_FLEET_BACKOFF_MIN', '5'))
    bmax = float(os.environ.get('SCT_FLEET_BACKOFF_MAX', '300'))
    poll = float(os.environ.get('SCT_FLEET_POLL', '1'))
    st = dict(pid=os.getpid(), started=dt.datetime.now().isoformat(timespec='seconds'), session=session,
              mode=None, why='', child_pid=None, child_started=None, restarts=0, last_exit=None,
              last_exit_at=None, next_start_in=0, sync=dict(state='not_started', line='', at=None))
    lock = threading.Lock()
    stop = threading.Event()
    child = None
    backoff, next_start = bmin, 0.0

    def note(msg):
        print(f'[fleet-service] {msg}', flush=True)

    def save():
        with lock:
            try:
                write_status(status_path, st)
            except OSError:
                pass

    def pump(proc):
        for raw in iter(proc.stdout.readline, b''):
            line = raw.decode(errors='replace').rstrip()
            print(line, flush=True)
            for key, state in SYNC_LINES:
                if key in line:
                    with lock:
                        st['sync'] = dict(state=state, line=line[-200:], at=dt.datetime.now().isoformat(timespec='seconds'))
                    save()

    def stop_child(proc, why):
        note(f'stopping fleet_bridge pid {proc.pid}: {why}')
        try:
            os.killpg(proc.pid, signal.SIGINT)
            proc.wait(10)
        except subprocess.TimeoutExpired:
            os.killpg(proc.pid, signal.SIGKILL)
            proc.wait(5)
        except ProcessLookupError:
            pass

    def time_ok():
        # docs/fleet-bridge.md: never start the bridge on an unsynchronized clock (boot before NTP).
        gate = os.environ.get('SCT_FLEET_TIME_GATE') or f'{sys.executable} {os.path.join(ROBOT_DIR, "scripts", "check_fleet_time_sync.py")}'
        try:
            r = subprocess.run(gate.split(), capture_output=True, text=True, timeout=20)
            ok, msg = r.returncode == 0, (r.stdout + r.stderr).strip().splitlines()[-1:] or ['']
        except (OSError, subprocess.SubprocessError) as exc:
            ok, msg = False, [str(exc)]
        if not ok:
            with lock:
                st.update(mode=None, why=f'waiting for NTP: {msg[0][:160]}')
        return ok

    def on_signal(signum, _frame):
        stop.set()
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    note(f'started (pid {os.getpid()}, logs {session}); commands policy {p["FLEET_SERVICE_COMMANDS"]}')
    save()
    try:
        while not stop.is_set():
            want, why = fleet_wanted_commands(p)
            if want:
                try:
                    check_fleet_runtime(env, commands=True)
                except Refused as exc:
                    want, why = False, f'commands refused: {exc}'
            mode = 'commands' if want else 'telemetry'
            if child is not None and child.poll() is None and mode != st['mode']:
                stop_child(child, f'mode {st["mode"]} -> {mode} ({why})')
                child.wait()
                child, next_start, backoff = None, 0.0, bmin
            if child is not None and child.poll() is not None:
                code = child.returncode
                ran = time.monotonic() - child_t0
                backoff = bmin if ran > 60 else min(bmax, backoff * 2 if st['restarts'] else bmin)
                if code == 2:
                    backoff = bmax           # configuration error: retrying fast cannot fix it
                next_start = time.monotonic() + backoff
                with lock:
                    st.update(last_exit=code, last_exit_at=dt.datetime.now().isoformat(timespec='seconds'),
                              child_pid=None, restarts=st['restarts'] + 1)
                note(f'fleet_bridge exited with {code} after {ran:.0f} s; restart in {backoff:.0f} s')
                child = None
                save()
            if child is None and time.monotonic() >= next_start:
                others = [x for x in scan_processes() if x['name'] == 'fleet_bridge']
                for x in [x for x in others if service_child(x['pid'])]:
                    # We hold the fleet lock, so no other supervisor lives: a bridge marked as a service
                    # child is left over from one that died (SIGKILL outside systemd). Stop it.
                    note(f'stopping leftover service fleet_bridge pid {x["pid"]}')
                    stop_pid(x['pid'])
                    others.remove(x)
                if others:
                    with lock:
                        st['why'] = f'another fleet_bridge runs (pid {others[0]["pid"]}); waiting'
                    next_start = time.monotonic() + 10
                    save()
                elif not time_ok():
                    next_start = time.monotonic() + 15
                    save()
                else:
                    try:
                        values = read_fleet_env(p)
                        argv = fleet_argv(p, env, values, want)
                    except Refused as exc:
                        note(f'cannot start fleet_bridge: {exc}')
                        with lock:
                            st.update(why=f'cannot start: {exc}', mode=None)
                        next_start = time.monotonic() + bmax
                        save()
                        stop.wait(poll)
                        continue
                    test_exec = os.environ.get('SCT_ROBOT_TEST_EXEC')   # offline tests only
                    # The bridge executable itself, not "ros2 run": its pid is then the bridge's pid.
                    exe = os.path.join(package_prefix(env, 'fleet_bridge') or '', 'lib', 'fleet_bridge', 'fleet_bridge')
                    cmd = [test_exec, *argv] if test_exec else ([exe, *argv[4:]] if os.path.isfile(exe) else argv)
                    cenv = dict(env, **values, ROS_LOG_DIR=os.path.join(session, 'ros_log'), PYTHONUNBUFFERED='1',
                                RCUTILS_LOGGING_BUFFERED_STREAM='0', SCT_FLEET_SERVICE='1')
                    child = subprocess.Popen(cmd, env=cenv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                             start_new_session=True)
                    child_t0 = time.monotonic()
                    threading.Thread(target=pump, args=(child,), daemon=True).start()
                    with lock:
                        st.update(mode=mode, why=why, child_pid=child.pid,
                                  child_started=dt.datetime.now().isoformat(timespec='seconds'),
                                  sync=dict(state='starting', line='', at=None))
                    note(f'fleet_bridge pid {child.pid} started in {mode} mode ({why})')
                    save()
            with lock:
                st['next_start_in'] = max(0, round(next_start - time.monotonic())) if child is None else 0
            stop.wait(poll)
    finally:
        if child is not None and child.poll() is None:
            stop_child(child, 'service stopping')
        with lock:
            st.update(child_pid=None, mode=None, why='stopped', stopped=dt.datetime.now().isoformat(timespec='seconds'))
        save()
        os.close(fd)
    return 0


def service_child(pid):
    """True when the process carries the SCT_FLEET_SERVICE mark the supervisor sets on its bridge."""
    try:
        return b'SCT_FLEET_SERVICE=1' in open(os.path.join(PROC, str(pid), 'environ'), 'rb').read().split(b'\0')
    except OSError:
        return False


def stop_pid(pid, wait=10.0):
    import signal
    for sig, limit in ((signal.SIGINT, wait), (signal.SIGKILL, 5.0)):
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            return
        end = time.monotonic() + limit
        while time.monotonic() < end:
            if not os.path.exists(f'/proc/{pid}'):
                return
            time.sleep(0.2)


def systemctl_user(*args):
    return subprocess.run(['systemctl', '--user', *args], capture_output=True, text=True, timeout=20)


def cmd_fleet_status(p):
    try:
        active = systemctl_user('is-active', FLEET_UNIT).stdout.strip() or 'unknown'
        enabled = systemctl_user('is-enabled', FLEET_UNIT).stdout.strip() or 'not installed'
    except (OSError, subprocess.SubprocessError):
        active, enabled = 'unknown', 'unknown'
    try:
        linger = subprocess.run(['loginctl', 'show-user', os.environ.get('USER', ''), '-p', 'Linger', '--value'],
                                capture_output=True, text=True, timeout=10).stdout.strip() or '?'
    except (OSError, subprocess.SubprocessError):
        linger = '?'
    print(f'service      {FLEET_UNIT}: {active}, {enabled}; linger {linger}'
          + ('' if linger == 'yes' else ' (needed to start at boot without a login: sudo loginctl enable-linger $USER)'))
    held = lock_info('fleet')
    path = os.path.join(STATE_DIR, FLEET_STATUS)
    st = None
    if os.path.isfile(path):
        try:
            st = json.load(open(path))
        except (OSError, ValueError):
            st = None
    if held and held.get('service') and st and st.get('pid') == held.get('pid'):
        sync = st.get('sync') or {}
        print(f'supervisor   pid {st["pid"]} since {st["started"]}; bridge mode {st.get("mode") or "-"} '
              f'({st.get("why")}); restarts {st.get("restarts")}, last exit {st.get("last_exit")}')
        print(f'backend      {sync.get("state")} at {sync.get("at")}: {sync.get("line", "")[-120:]}')
        print(f'logs         {st.get("session")}')
    elif held:
        print(f'fleet        foreground "robot fleet" running: {json.dumps(held)}')
    else:
        print('fleet        not running')
    want, why = fleet_wanted_commands(p)
    print(f'commands     policy {p["FLEET_SERVICE_COMMANDS"]}: {"on" if want else "off"} now ({why}). '
          'Online is not ready: the web still needs localized, motion ready and dispatch enabled')
    for x in scan_processes():
        if x['name'] == 'fleet_bridge':
            print(f'  fleet_bridge pid {x["pid"]} commands_enabled={fleet_bridge_commands(x)}')
    return 0

def run(argv, env, dry_run, lock=None, session=None, extra_env=None):
    env = dict(env, **(extra_env or {}))
    if dry_run:
        print(json.dumps(dict(argv=argv, env=env_diff(env), session=session, lock=lock), indent=1))
        return 0
    fd = None
    if lock:
        fd = take_lock(lock[0], lock[1])
    if session:
        json.dump(dict(argv=argv, pid=os.getpid(), start_ticks=start_ticks(os.getpid(), '/proc'),
                       env=env_diff(env), started=dt.datetime.now().isoformat()),
                  open(os.path.join(session, 'session.json'), 'w'), indent=1)
    sys.stdout.flush()
    test_exec = os.environ.get('SCT_ROBOT_TEST_EXEC')     # offline tests only: run this instead of argv[0]
    if test_exec:
        os.execve(test_exec, [test_exec, *argv], env)
    os.execvpe(argv[0], argv, env)


def launcher_origin():
    """Where this launcher runs from: a staged release (PROVENANCE) or a checkout."""
    prov = os.path.join(os.path.dirname(ROBOT_DIR), 'PROVENANCE')
    if os.path.isfile(prov):
        first = [x for x in open(prov).read().split('\n') if x.startswith(('commit:', 'describe:'))]
        return f'release {ROBOT_DIR} ({"; ".join(first)})'
    r = subprocess.run(['git', '-C', ROBOT_DIR, 'status', '--porcelain', '--untracked-files=no', '--', '.'],
                       capture_output=True, text=True)
    head = subprocess.run(['git', '-C', ROBOT_DIR, 'rev-parse', '--short', 'HEAD'], capture_output=True, text=True)
    if head.returncode == 0:
        return (f'CHECKOUT {ROBOT_DIR} @ {head.stdout.strip()}{" DIRTY" if r.stdout.strip() else ""} '
                '(follows edits; install from a release: robot/scripts/stage-runtime --tools-only)')
    return f'{ROBOT_DIR} (no PROVENANCE, not a git checkout)'


def cmd_status(p):
    state, why = calibration(p)
    m, n = resolve_data(p)
    print(f'profile      {PROFILE}')
    print(f'launcher     {launcher_origin()}')
    print(f'robot root   {p["SCT_ROBOT_ROOT"]}  (.env, base install, maps)')
    print(f'overlay      {p["SCT_OVERLAY"] or "(none)"}')
    prov = os.path.join(os.path.dirname(p['SCT_OVERLAY'].rstrip('/')), 'PROVENANCE') if p['SCT_OVERLAY'] else ''
    if prov and os.path.isfile(prov):
        print('             ' + ' | '.join(open(prov).read().split('\n')[:2]))
    elif p['SCT_OVERLAY']:
        print('             no PROVENANCE file: not built by stage-runtime (may follow a checkout)')
    try:
        env = build_env(p)
        print(f'DDS          domain {env["ROS_DOMAIN_ID"]}, {env["RMW_IMPLEMENTATION"]}, discovery '
              f'{env["ROS_DISCOVERY_SERVER"]}, localhost_only {env.get("ROS_LOCALHOST_ONLY", "0")}')
        for pkg in ('stm32_bridge', 'robot_control', 'robot_navigation', 'robot_nav_plugins'):
            print(f'  {pkg:18s} {package_prefix(env, pkg) or "MISSING"}')
    except Refused as exc:
        print(f'environment  REFUSED: {exc}')
    print(f'robot_id     {p["ROBOT_ID"]}')
    allowed = [w for w, ok in CALIBRATION_ALLOWS.items() if state in ok]
    print(f'lidar_yaw    {p["LIDAR_YAW"]} rad: {state} ({why}); launcher allows: {", ".join(allowed) or "nothing"}')
    if p['LIDAR_YAW_CANDIDATE']:
        print(f'candidate    {p["LIDAR_YAW_CANDIDATE"]} rad (static check only: robot lidar-check)')
    print(f'map / params {m} | {n}')
    procs = scan_processes()
    held = lock_info('workflow')
    print(f'workflow     {"running: " + json.dumps(held) if held else "none (no launcher lock)"}')
    for x in procs:
        extra = f' commands_enabled={fleet_bridge_commands(x)}' if x['name'] == 'fleet_bridge' else ''
        print(f'  {x["name"]:18s} pid {x["pid"]:<7d} domain {x["domain"]} ns {x["namespace"]}{extra}')
    if not procs:
        print('  no robot, teleop, recorder or stop-key process')
    fl = lock_info('fleet')
    print(f'fleet        {("service " if fl.get("service") else "foreground ") + json.dumps(fl) if fl else "not running"}'
          ' (details: robot fleet status)')
    ss = sessions(p)
    total = sum(s['size'] for s in ss) / 1e6
    print(f'logs         {len(ss)} launcher sessions under {log_root(p)}, ros_log {total:.0f} MB '
          f'(budget {p["LOG_MAX_MB"]} MB, keep {p["LOG_KEEP_DAYS"]} days), {free_gb(log_root(p)):.1f} GB free')
    return 0


def cmd_logs(p, prune, yes):
    ss = sessions(p)
    if not prune:
        for s in ss:
            print(f'{s["size"] / 1e6:8.1f} MB  {"LIVE " if s["alive"] else "     "}{s["dir"]}')
        print(f'{sum(s["size"] for s in ss) / 1e6:8.1f} MB total in {len(ss)} launcher sessions')
        return 0
    keep_s = float(p['LOG_KEEP_DAYS']) * 86400
    budget = float(p['LOG_MAX_MB']) * 1e6
    now = time.time()
    candidates = [s for s in ss if s['has_logs'] and not s['alive']]
    held = lock_info('workflow') or {}
    candidates = [s for s in candidates if s['dir'] != held.get('session')]
    chosen = [s for s in candidates if now - s['mtime'] > keep_s]
    total = sum(s['size'] for s in ss) - sum(s['size'] for s in chosen)
    for s in sorted(candidates, key=lambda s: s['mtime']):
        if total <= budget:
            break
        if s not in chosen:
            chosen.append(s)
            total -= s['size']
    for s in chosen:
        print(f'{"removing" if yes else "would remove"} {s["dir"]}/ros_log ({s["size"] / 1e6:.1f} MB); bag and session.json kept')
        if yes:
            shutil.rmtree(os.path.join(s['dir'], 'ros_log'))
    if not chosen:
        print('nothing to prune')
    elif not yes:
        print('dry run: add --yes to remove')
    return 0


def cmd_accept(p, directory, yes):
    v = read_verdict(directory)
    if v.get('verdict') != 'PASS' or v.get('tf_ok') != 'True':
        raise Refused(f'{directory}: verdict {v.get("verdict")}, tf_ok {v.get("tf_ok")}; only a PASS can be accepted')
    if not p['LIDAR_YAW_CANDIDATE'] or not angle_equal(v.get('candidate_rad', 'nan'), p['LIDAR_YAW_CANDIDATE']):
        raise Refused(f'the check measured {v.get("candidate_rad")}, the profile candidate is {p["LIDAR_YAW_CANDIDATE"]!r}')
    new = {'LIDAR_YAW': v['candidate_rad'], 'LIDAR_YAW_EVIDENCE': os.path.abspath(directory),
           'LIDAR_YAW_PREVIOUS': p['LIDAR_YAW']}
    print(f'LIDAR_YAW {p["LIDAR_YAW"]} -> {new["LIDAR_YAW"]} (wall check difference {v.get("difference_deg")} deg)')
    if not yes:
        print('dry run: add --yes to write the profile (a timestamped backup is kept)')
        return 0
    backup = f'{PROFILE}.bak-{dt.datetime.now():%Y%m%d_%H%M%S}'
    shutil.copy2(PROFILE, backup)
    lines, seen = [], set()
    for raw in open(PROFILE, encoding='utf-8'):
        key = raw.split('=', 1)[0].strip()
        if key in new:
            lines.append(f'{key}={new[key]}\n')
            seen.add(key)
        else:
            lines.append(raw)
    lines += [f'{k}={v}\n' for k, v in new.items() if k not in seen]
    tmp = PROFILE + '.tmp'
    open(tmp, 'w', encoding='utf-8').writelines(lines)
    os.replace(tmp, PROFILE)
    print(f'written; backup {backup}. Roll back: cp {backup} {PROFILE}')
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog='robot', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='cmd')
    sub.add_parser('status')
    sub.add_parser('env')
    sub.add_parser('shell')
    for w in WORKFLOWS:
        wp = sub.add_parser(w)
        if w == 'nav':
            wp.add_argument('--fleet', action='store_true',
                            help='start mode_manager with require_motion_permit for a fleet command session')
            pose = wp.add_mutually_exclusive_group()
            pose.add_argument('--auto-pose', action='store_true',
                              help='set the initial pose from the LiDAR (overrides AUTO_INITIAL_POSE)')
            pose.add_argument('--manual-pose', action='store_true',
                              help='wait for a 2D Pose Estimate as before (overrides AUTO_INITIAL_POSE)')
            cam = wp.add_mutually_exclusive_group()
            cam.add_argument('--camera', action='store_true',
                             help='add the Astra depth camera to the local costmap (overrides ENABLE_CAMERA)')
            cam.add_argument('--no-camera', action='store_true',
                             help='LiDAR-only local costmap, the baseline (overrides ENABLE_CAMERA)')
    fl = sub.add_parser('fleet', help='fleet_bridge: foreground, or the boot service (status/start/stop/restart/logs)')
    fl.add_argument('action', nargs='?', choices=('status', 'start', 'stop', 'restart', 'logs'))
    fl.add_argument('--commands', action='store_true')
    fl.add_argument('--service', action='store_true', help=argparse.SUPPRESS)   # run by sct-fleet.service
    fl.add_argument('-f', '--follow', action='store_true', help='with logs: follow')
    sub.add_parser('reset-latch')
    sub.add_parser('relocalize', help='redo the LiDAR initial pose (robot nav with auto pose, robot stationary)')
    sub.add_parser('viewer', help='bridge for RViz on the laptop (amr-rviz --r3)')
    t = sub.add_parser('teleop')
    t.add_argument('--speed', type=float)
    t.add_argument('--turn', type=float)
    sub.add_parser('stop')
    pf = sub.add_parser('preflight')
    pf.add_argument('workflow', choices=WORKFLOWS)
    pf.add_argument('--static', action='store_true')
    rec = sub.add_parser('record')
    rec.add_argument('action', choices=('start', 'stop'))
    rec.add_argument('dir', nargs='?')
    lc = sub.add_parser('lidar-check', help='args after -- go to static_lidar_check.sh')
    lc.add_argument('rest', nargs=argparse.REMAINDER)
    cal = sub.add_parser('calibration')
    cal.add_argument('action', choices=('accept',))
    cal.add_argument('dir')
    cal.add_argument('--yes', action='store_true')
    lg = sub.add_parser('logs')
    lg.add_argument('action', nargs='?', choices=('prune',))
    lg.add_argument('--yes', action='store_true')
    argv = list(sys.argv[1:] if argv is None else argv)
    # --dry-run anywhere (before the subcommand, after '--', twice) means a dry run of
    # whatever command it is; it never reaches argparse or a passthrough tool.
    dry_run = '--dry-run' in argv
    argv = [x for x in argv if x != '--dry-run']
    a = ap.parse_args(argv)
    a.dry_run = dry_run
    try:
        p = load_profile()
        if a.cmd in (None, 'status'):
            return cmd_status(p)
        if a.cmd == 'logs':
            return cmd_logs(p, a.action == 'prune', a.yes and not a.dry_run)
        if a.cmd == 'calibration':
            return cmd_accept(p, a.dir, a.yes and not a.dry_run)
        if a.cmd == 'fleet' and a.action == 'status':
            return cmd_fleet_status(p)
        if a.cmd == 'fleet' and a.action in ('start', 'stop', 'restart', 'logs'):
            argv = (['journalctl', '--user', '-u', FLEET_UNIT, '-n', '200', '--no-pager'] + (['-f'] if a.follow else [])
                    if a.action == 'logs' else ['systemctl', '--user', a.action, FLEET_UNIT])
            if a.dry_run:
                print(json.dumps(dict(argv=argv), indent=1))
                return 0
            os.execvp(argv[0], argv)
        env = build_env(p)
        if a.cmd == 'env':
            for k, v in sorted(env.items()):
                print(f'{k}={v}')
            return 0
        if a.cmd == 'shell' and a.dry_run:
            print(json.dumps(dict(argv=['bash', '--noprofile', '--norc', '-i'], env=env_diff(env)), indent=1))
            return 0
        if a.cmd == 'shell':
            env['PS1'] = f'[robot {p["ROBOT_ID"]} d{env["ROS_DOMAIN_ID"]}] \\w$ '
            os.execvpe('bash', ['bash', '--noprofile', '--norc', '-i'], env)
        procs = scan_processes()
        tools = os.path.join(ROBOT_DIR, 'tools')
        if a.cmd in WORKFLOWS:
            fleet = bool(getattr(a, 'fleet', False))
            check_workflow(p, env, a.cmd, procs)
            if fleet:
                check_fleet_runtime(env, commands=False)
            auto_pose = a.cmd == 'nav' and auto_pose_wanted(p, a)
            if auto_pose:
                check_auto_pose_runtime(env, resolve_data(p)[0])
            camera = a.cmd == 'nav' and camera_wanted(p, a)
            if camera:
                why = camera_problem(env)
                if why:
                    camera = False
                    print(f'WARNING depth camera off for this session, LiDAR-only: {why}', file=sys.stderr)
            argv = workflow_argv(p, a.cmd, fleet, auto_pose, camera)
            if a.dry_run:
                return run(argv, env, True, lock=('workflow', a.cmd), session='(new session directory)')
            session = new_session(p, a.cmd)
            if auto_pose:
                print('Initial pose from the LiDAR: keep the robot still for a few seconds after Nav2 is up. '
                      'Result on /' + p['ROBOT_ID'] + '/pose_bootstrap/status; NEEDS_MANUAL_POSE = set it in RViz.')
            if fleet:
                svc = lock_info('fleet') or {}
                if svc.get('service') and p['FLEET_SERVICE_COMMANDS'].strip().lower() != 'off':
                    print('fleet service: switches fleet_bridge to commands a few seconds after Nav2 starts, and back '
                          'to telemetry when this session ends (robot fleet status).')
                elif svc.get('service'):
                    print('fleet service runs telemetry only (FLEET_SERVICE_COMMANDS=off): no Tour from the web.')
                else:
                    print('no fleet service: run "robot fleet --commands" in another terminal for Tours from the web.')
            return run(argv, env, False, lock=('workflow', dict(workflow=a.cmd, fleet=fleet, pid=os.getpid(),
                                                                session=session)),
            return run(argv, env, False, lock=('workflow', dict(workflow=a.cmd, fleet=fleet, auto_pose=auto_pose,
                                                                camera=camera,
                                                                pid=os.getpid(), session=session)),
                       session=session, extra_env={'ROS_LOG_DIR': os.path.join(session, 'ros_log')})
        if a.cmd == 'teleop':
            speed = a.speed if a.speed is not None else float(p['TELEOP_SPEED'])
            turn = a.turn if a.turn is not None else float(p['TELEOP_TURN'])
            if not (0 < speed <= TELEOP_LIMITS['TELEOP_SPEED'] and 0 < turn <= TELEOP_LIMITS['TELEOP_TURN']):
                raise Refused(f'speed/turn above the caps {TELEOP_LIMITS}')
            if not a.dry_run:
                check_teleop(p, env, procs)
            log_dir = tool_log_dir(p, 'teleop', a.dry_run)
            argv = ['ros2', 'run', 'teleop_twist_keyboard', 'teleop_twist_keyboard', '--ros-args',
                    '-r', f'cmd_vel:=/{p["ROBOT_ID"]}/cmd_vel_manual', '-p', f'speed:={speed}', '-p', f'turn:={turn}']
            return run(argv, env, a.dry_run, lock=('teleop', dict(pid=os.getpid())), extra_env={'ROS_LOG_DIR': log_dir})
        if a.cmd == 'stop':
            argv = ['python3', os.path.join(tools, 'ops', 'stopkey.py'), '/' + p['ROBOT_ID']]
            if not a.dry_run:
                print('robot stop = SOFTWARE stop key. It does NOT cut motor power; the hardware E-stop is the physical button.')
            return run(argv, env, a.dry_run, extra_env={'ROS_LOG_DIR': tool_log_dir(p, 'stop', a.dry_run)})
        if a.cmd == 'preflight':
            names = {'manual': 'manual', 'map': 'mapping', 'nav': 'navigation'}
            argv = ['python3', os.path.join(tools, 'preflight', 'preflight.py'), names[a.workflow],
                    '--lidar-yaw', p['LIDAR_YAW'], '--ns', '/' + p['ROBOT_ID']] + (['--static'] if a.static else [])
            return run(argv, env, a.dry_run, extra_env={'ROS_SUPER_CLIENT': 'TRUE',
                                                        'ROS_LOG_DIR': tool_log_dir(p, 'preflight', a.dry_run)})
        if a.cmd == 'record':
            held = lock_info('workflow') or {}
            d = a.dir or held.get('session')
            if not d:
                raise Refused('no session directory: give one, or start a workflow with robot first')
            argv = ['bash', os.path.join(tools, 'ops', 'record_session.sh'), a.action, d]
            return run(argv, env, a.dry_run, extra_env={'ROBOT_NS': '/' + p['ROBOT_ID']})
        if a.cmd == 'fleet' and a.service:
            if lock_info('fleet'):
                raise Refused(f'fleet lock held: {json.dumps(lock_info("fleet"))}')
            if a.dry_run:
                want, why = fleet_wanted_commands(p)
                values = read_fleet_env(p)
                return run(fleet_argv(p, env, values, want), env, True, lock=('fleet', dict(service=True)))
            return fleet_service(p, env)
        if a.cmd == 'fleet':
            held_fleet = lock_info('fleet') or {}
            if held_fleet.get('service'):
                raise Refused('the fleet service owns the bridge (robot fleet status). It switches to commands by '
                              'itself while "robot nav --fleet" runs; to run one by hand: robot fleet stop')
            if any(x['name'] == 'fleet_bridge' for x in procs) or held_fleet:
                raise Refused('a fleet_bridge is already running')
            values = read_fleet_env(p)
            if a.commands:
                held = lock_info('workflow') or {}
                if held.get('workflow') != 'nav':
                    raise Refused('fleet --commands needs a running "robot nav" session (Nav2 receives the goals); '
                                  'start that first')
                if not held.get('fleet'):
                    print('note: "robot nav" runs without --fleet, so there is no motion permit: if the link to the '
                          'backend drops during a leg the robot finishes that leg. Keep someone at the E-stop.',
                          file=sys.stderr)
                if any(x['name'] in COMMAND_SOURCES for x in procs):
                    print('note: a teleop is running; manual commands override Nav2 and cancel its goal',
                          file=sys.stderr)
                if held.get('fleet'):
                    check_fleet_runtime(env, commands=True)
                if not values.get('FLEET_MAP_PACKAGE_PATH'):
                    print(f'note: no FLEET_MAP_PACKAGE_PATH in {p["FLEET_ENV_FILE"]}: the web will show '
                          'MAP_EVIDENCE_MISSING and the robot never reports ready to move', file=sys.stderr)
            argv = fleet_argv(p, env, values, a.commands)
            extra = dict(values, ROS_LOG_DIR=tool_log_dir(p, 'fleet', a.dry_run))
            if a.dry_run:          # FLEET_* values stay out of the printed environment
                return run(argv, env, True, lock=('fleet', dict(commands=a.commands)))
            if a.commands:
                print('fleet_bridge WITH COMMANDS: Tours started on the web will move the robot. Keep someone at '
                      'the E-stop.' + (' Clear the gate with "robot reset-latch" when ready.'
                                       if (lock_info('workflow') or {}).get('fleet') else ''))
            return run(argv, env, False, lock=('fleet', dict(commands=a.commands, pid=os.getpid())), extra_env=extra)
        if a.cmd == 'reset-latch':
            held = lock_info('workflow') or {}
            if not held.get('fleet'):
                raise Refused('no "robot nav --fleet" session: nothing to reset')
            argv = ['ros2', 'service', 'call', f'/{p["ROBOT_ID"]}/motion_inhibit_reset', 'std_srvs/srv/Trigger', '{}']
            if not a.dry_run:
                print('Clearing the motion gate latch: only when the robot, the area and the attendant are ready.')
            return run(argv, env, a.dry_run, extra_env={'ROS_SUPER_CLIENT': 'TRUE',
                                                        'ROS_LOG_DIR': tool_log_dir(p, 'reset', a.dry_run)})
        if a.cmd == 'relocalize':
            held = lock_info('workflow') or {}
            if held.get('workflow') != 'nav' or not held.get('auto_pose'):
                raise Refused('relocalize needs "robot nav" started with the auto pose (--auto-pose or AUTO_INITIAL_POSE)')
            argv = ['ros2', 'service', 'call', f'/{p["ROBOT_ID"]}/pose_bootstrap/relocalize', 'std_srvs/srv/Trigger', '{}']
            if not a.dry_run:
                print('Relocalizing from the LiDAR: the robot must be stationary with no goal running.')
            return run(argv, env, a.dry_run, extra_env={'ROS_SUPER_CLIENT': 'TRUE',
                                                        'ROS_LOG_DIR': tool_log_dir(p, 'relocalize', a.dry_run)})
        if a.cmd == 'viewer':
            if (lock_info('workflow') or {}).get('workflow') not in ('nav', 'map') and not a.dry_run:
                raise Refused('viewer needs a running "robot nav" or "robot map"')
            if any(x['name'] == 'viewer_bridge' for x in procs):
                raise Refused('a viewer bridge is already running')
            bridge_launch = share_file(env, 'robot_navigation', 'launch', 'debug_bridge.launch.py')
            if not bridge_launch or not os.path.isfile(bridge_launch):
                raise Refused('this runtime has no debug_bridge.launch.py')
            fox = os.path.expanduser(p['FOXGLOVE_ENV'])
            if not os.path.isfile(fox):
                raise Refused(f'FOXGLOVE_ENV not found: {fox}')
            argv = ['bash', '-c', 'source "$1" && shift && exec "$@"', 'viewer', fox,
                    'ros2', 'launch', 'robot_navigation', 'debug_bridge.launch.py', f'robot_id:={p["ROBOT_ID"]}']
            if not a.dry_run:
                print('Viewer bridge for the laptop: run "amr-rviz --r3" there. Ctrl+C here closes only the viewer.')
            return run(argv, env, a.dry_run, extra_env={'ROS_LOG_DIR': tool_log_dir(p, 'viewer', a.dry_run)})
        if a.cmd == 'lidar-check':
            if not p['LIDAR_YAW_CANDIDATE']:
                raise Refused('LIDAR_YAW_CANDIDATE is not set in the profile')
            if robot_nodes(procs) or lock_info('workflow'):
                raise Refused('stop the running workflow first; the static check owns the LiDAR alone')
            rest = [x for x in a.rest if x != '--']
            if '--lidar-yaw' in rest:
                raise Refused('the static check always uses LIDAR_YAW_CANDIDATE from the profile')
            argv = ['bash', os.path.join(tools, 'lidar_calibration', 'static_lidar_check.sh'), *rest,
                    '--lidar-yaw', p['LIDAR_YAW_CANDIDATE']]
            return run(argv, env, a.dry_run)
    except Refused as exc:
        print(f'REFUSED: {exc}', file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    sys.exit(main())
