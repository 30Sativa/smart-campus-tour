#!/usr/bin/env python3
"""robot: start the real robot's workflows, each process with its own environment.

The calling shell does not matter: every command builds its environment from a clean
base, the machine profile (~/.config/sct-robot/runtime.env), the robot .env through
robot/scripts/source-minipc, and at most ONE overlay. Nothing here edits a shell
startup file, an overlay or a symlink. See robot/docs/robot-launcher.md.

  robot status                      read-only: profile, runtime, calibration, processes, logs
  robot env | shell                 print the environment / open a shell with it
  robot manual | map | nav          start one workflow (refused while another runs)
  robot teleop                      keyboard teleop for the running workflow
  robot stop                        SOFTWARE stop key (not the hardware E-stop)
  robot preflight <workflow> [--static]
  robot record start|stop [DIR]
  robot lidar-check ...             static wall check of the CANDIDATE LiDAR yaw
  robot calibration accept DIR [--yes]
  robot logs [prune [--yes]]
--dry-run on manual/map/nav/teleop/stop/preflight/record/lidar-check prints the command
and environment and starts nothing. status, env and --dry-run never talk to ROS.
"""
import argparse
import datetime as dt
import fcntl
import json
import math
import os
import re
import shutil
import subprocess
import sys
import time

ROBOT_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))   # robot/ holding these tools
PROFILE = os.environ.get('SCT_ROBOT_PROFILE', os.path.expanduser('~/.config/sct-robot/runtime.env'))
STATE_DIR = os.environ.get('SCT_ROBOT_STATE', os.path.expanduser('~/.local/state/sct-robot'))
PROC = os.environ.get('SCT_PROC_ROOT', '/proc')
ROS_SETUP = '/opt/ros/humble'
WORKFLOWS = ('manual', 'map', 'nav')
# LiDAR yaw values that have run on the robot as a recorded baseline. Any other value
# needs LIDAR_YAW_EVIDENCE: a static check directory whose verdict.txt is PASS for it.
BASELINE_LIDAR_YAWS = {'robot-baseline-20261102': -3.0695}
TELEOP_LIMITS = {'TELEOP_SPEED': 0.30, 'TELEOP_TURN': 1.00}        # m/s, rad/s hard caps
PROFILE_KEYS = {
    'SCT_ROBOT_ROOT': None, 'SCT_OVERLAY': '', 'ROBOT_ID': None,
    'LIDAR_YAW': None, 'LIDAR_YAW_EVIDENCE': '', 'LIDAR_YAW_CANDIDATE': '', 'LIDAR_YAW_PREVIOUS': '',
    'MAP': 'map2.yaml', 'NAV2_PARAMS': 'nav2_params_v2.yaml', 'MAP_MAX_WHEEL_SPEED_MM_S': '250.0',
    'TELEOP_SPEED': '0.1', 'TELEOP_TURN': '0.3',
    'SCT_LOG_ROOT': '~/amr_logs/runs', 'LOG_KEEP_DAYS': '30', 'LOG_MAX_MB': '2000', 'MIN_FREE_GB': '5',
}
NODE_PATTERNS = {
    'stm32_bridge_node': r'stm32_bridge_node', 'mode_manager_node': r'mode_manager_node',
    'ekf_node': r'/ekf_node( |$)', 'robot_state_publisher': r'/robot_state_publisher( |$)',
    'rplidar_node': r'/rplidar_node( |$)', 'slam_toolbox': r'async_slam_toolbox_node',
    'amcl': r'/nav2_amcl/amcl( |$)', 'controller_server': r'/controller_server( |$)',
    'frontier_explorer': r'simple_frontier_explorer',
}
COMMAND_SOURCES = {'teleop_keyboard': r'teleop_twist_keyboard', 'teleop_joy': r'/teleop_node( |$)'}
OTHER = {'bag_record': r'ros2 bag record', 'stopkey': r'stopkey\.py', 'preflight': r'preflight\.py'}


class Refused(Exception):
    pass


# ---- profile ----------------------------------------------------------------------
def load_profile(path=PROFILE):
    if not os.path.isfile(path):
        raise Refused(f'no profile at {path}; copy robot/config/runtime.env.example there and edit it')
    values = {}
    for n, raw in enumerate(open(path, encoding='utf-8'), 1):
        line = raw.strip()
        if not line or line.startswith('#'):
            continue
        m = re.fullmatch(r'([A-Z0-9_]+)=(.*)', line)
        if not m:
            raise Refused(f'{path}:{n}: expected KEY=VALUE, got {line!r}')
        key, value = m.group(1), m.group(2).strip()
        if key not in PROFILE_KEYS:
            raise Refused(f'{path}:{n}: unknown key {key} (typo?)')
        if len(value) >= 2 and value[0] == value[-1] and value[0] in '"\'':
            value = value[1:-1]
        values[key] = os.path.expanduser(value.replace('$HOME', os.path.expanduser('~')))
    for key, default in PROFILE_KEYS.items():
        if key not in values:
            if default is None:
                raise Refused(f'{path}: {key} is required')
            values[key] = os.path.expanduser(default)
    p = values
    if not re.fullmatch(r'[a-z][a-z0-9_]*', p['ROBOT_ID']):
        raise Refused(f'ROBOT_ID {p["ROBOT_ID"]!r} is not a ROS name')
    for key in ('LIDAR_YAW', 'MAP_MAX_WHEEL_SPEED_MM_S', 'TELEOP_SPEED', 'TELEOP_TURN', 'LOG_KEEP_DAYS',
                'LOG_MAX_MB', 'MIN_FREE_GB'):
        try:
            float(p[key])
        except ValueError:
            raise Refused(f'{key}={p[key]!r} is not a number') from None
    for key, cap in TELEOP_LIMITS.items():
        if not 0 < float(p[key]) <= cap:
            raise Refused(f'{key}={p[key]} outside (0, {cap}]')
    if not 0 < float(p['MAP_MAX_WHEEL_SPEED_MM_S']) <= 350:
        raise Refused('MAP_MAX_WHEEL_SPEED_MM_S must be in (0, 350]')
    return p


def angle_equal(a, b, tol=1e-4):
    d = float(a) - float(b)
    return abs(math.atan2(math.sin(d), math.cos(d))) < tol


def read_verdict(directory):
    path = os.path.join(directory, 'verdict.txt')
    if not os.path.isfile(path):
        raise Refused(f'{path} not found (static_lidar_check.sh writes it)')
    v = dict(line.split('=', 1) for line in open(path).read().split() if '=' in line)
    return v


def calibration(p):
    """(usable_for_motion, explanation) for the profile's LIDAR_YAW."""
    yaw = float(p['LIDAR_YAW'])
    if p['LIDAR_YAW_EVIDENCE']:
        try:
            v = read_verdict(p['LIDAR_YAW_EVIDENCE'])
        except Refused as exc:
            return False, f'LIDAR_YAW {yaw} cites evidence that cannot be read: {exc}'
        if v.get('verdict') != 'PASS' or v.get('tf_ok') != 'True':
            return False, f'evidence {p["LIDAR_YAW_EVIDENCE"]} is {v.get("verdict")}, not PASS'
        if not angle_equal(v.get('candidate_rad', 'nan'), yaw):
            return False, f'evidence was measured for {v.get("candidate_rad")}, profile says {yaw}'
        return True, f'static wall check PASS ({p["LIDAR_YAW_EVIDENCE"]}, difference {v.get("difference_deg")} deg)'
    for tag, value in BASELINE_LIDAR_YAWS.items():
        if angle_equal(value, yaw):
            return True, f'baseline {tag}'
    return False, (f'LIDAR_YAW {yaw} is neither a recorded baseline value nor backed by a PASS static check '
                   f'(set LIDAR_YAW_EVIDENCE through "robot calibration accept")')


def resolve_data(p):
    root = p['SCT_ROBOT_ROOT']
    m = p['MAP'] if os.path.isabs(p['MAP']) else os.path.join(root, 'robot_maps', p['MAP'])
    n = p['NAV2_PARAMS'] if os.path.isabs(p['NAV2_PARAMS']) else \
        os.path.join(root, 'ros2_ws', 'src', 'robot_control', 'config', p['NAV2_PARAMS'])
    return m, n


# ---- environment --------------------------------------------------------------------
def clean_base_env():
    keep = ('HOME', 'USER', 'LOGNAME', 'SHELL', 'LANG', 'TERM', 'DISPLAY', 'XAUTHORITY', 'XDG_RUNTIME_DIR',
            'DBUS_SESSION_BUS_ADDRESS', 'SSH_AUTH_SOCK')
    env = {k: v for k, v in os.environ.items() if k in keep or k.startswith('LC_')}
    env['PATH'] = '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    return env


def build_env(p):
    """Environment of one robot process. Raises Refused with the reason."""
    root, overlay = p['SCT_ROBOT_ROOT'], p['SCT_OVERLAY']
    helper = os.path.join(ROBOT_DIR, 'scripts', 'source-minipc')
    for what, path in (('SCT_ROBOT_ROOT/.env', os.path.join(root, '.env')),
                       ('base install', os.path.join(root, 'ros2_ws', 'install', 'setup.bash')),
                       ('ROS 2 Humble', os.path.join(ROS_SETUP, 'setup.bash'))):
        if not os.path.isfile(path):
            raise Refused(f'{what} missing: {path}')
    if overlay and not os.path.isfile(os.path.join(overlay, 'setup.bash')):
        raise Refused(f'SCT_OVERLAY has no setup.bash: {overlay}')
    script = ('export ROBOT_RUNTIME_ROOT="$1"; source "$2" >/dev/null || exit 3; '
              'if [ -n "$3" ]; then source "$3/setup.bash" || exit 4; fi; env -0')
    r = subprocess.run(['bash', '--noprofile', '--norc', '-c', script, 'robot-env', root, helper, overlay],
                       env=clean_base_env(), capture_output=True, timeout=60)
    if r.returncode != 0:
        raise Refused(f'environment setup failed ({r.returncode}): {r.stderr.decode(errors="replace").strip()}')
    env = dict(kv.split('=', 1) for kv in r.stdout.decode(errors='replace').split('\0') if '=' in kv)
    env.pop('ROS_SUPER_CLIENT', None)
    for key in ('ROS_DOMAIN_ID', 'RMW_IMPLEMENTATION', 'ROS_DISCOVERY_SERVER'):
        if not env.get(key):
            raise Refused(f'{key} not set by {root}/.env')
    allowed = [os.path.realpath(x) for x in (ROS_SETUP, os.path.join(root, 'ros2_ws', 'install'), overlay) if x]
    for prefix in env.get('AMENT_PREFIX_PATH', '').split(':'):
        if prefix and not any(os.path.realpath(prefix) == a or os.path.realpath(prefix).startswith(a + os.sep)
                              for a in allowed):
            raise Refused(f'AMENT_PREFIX_PATH has {prefix}, outside ROS, the base install and SCT_OVERLAY '
                          '(the overlay chains to another workspace?)')
    return env


def package_prefix(env, pkg):
    for prefix in env.get('AMENT_PREFIX_PATH', '').split(':'):
        if prefix and os.path.exists(os.path.join(prefix, 'share', 'ament_index', 'resource_index', 'packages', pkg)):
            return prefix
    return None


# ---- processes ----------------------------------------------------------------------
def scan_processes(proc=PROC):
    """Own-user processes that matter, with domain and namespace."""
    found = []
    uid = os.getuid()
    for pid in filter(str.isdigit, os.listdir(proc)):
        base = os.path.join(proc, pid)
        try:
            if os.stat(base).st_uid != uid or int(pid) == os.getpid():
                continue
            cmd = open(os.path.join(base, 'cmdline'), 'rb').read().replace(b'\0', b' ').decode(errors='replace').strip()
        except (OSError, ValueError):
            continue
        if not cmd or re.search(r'(^|/)robot (status|env)', cmd):
            continue
        # `ros2 run` wrappers repeat the executable name; count the real binaries
        if re.match(r'^\S*python3 \S*/ros2 run ', cmd):
            continue
        for group in (NODE_PATTERNS, COMMAND_SOURCES, OTHER):
            for name, pat in group.items():
                if re.search(pat, cmd):
                    try:
                        environ = open(os.path.join(base, 'environ'), 'rb').read().split(b'\0')
                        envd = dict(x.decode(errors='replace').split('=', 1) for x in environ if b'=' in x)
                    except OSError:
                        envd = {}
                    ns = re.search(r'__ns:=(\S+)', cmd)
                    found.append(dict(pid=int(pid), name=name, domain=envd.get('ROS_DOMAIN_ID'),
                                      namespace=ns.group(1) if ns else None, cmd=cmd[:160]))
    return found


def robot_nodes(procs):
    return [x for x in procs if x['name'] in NODE_PATTERNS]


# ---- lock and sessions --------------------------------------------------------------
def lock_info(name):
    path = os.path.join(STATE_DIR, name + '.lock')
    if not os.path.exists(path):
        return None
    fd = os.open(path, os.O_RDWR)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        fcntl.flock(fd, fcntl.LOCK_UN)
        return None                                    # nobody holds it
    except BlockingIOError:
        try:
            return json.loads(open(path).read() or '{}')
        except ValueError:
            return {'workflow': '?'}
    finally:
        os.close(fd)


def take_lock(name, info):
    os.makedirs(STATE_DIR, exist_ok=True)
    path = os.path.join(STATE_DIR, name + '.lock')
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        raise Refused(f'{name} lock held: {json.dumps(lock_info(name))}') from None
    os.ftruncate(fd, 0)
    os.write(fd, json.dumps(info).encode())
    os.set_inheritable(fd, True)                       # the exec'd launch keeps holding it
    return fd


def log_root(p):
    return os.path.expanduser(p['SCT_LOG_ROOT'])


def new_session(p, workflow):
    root = log_root(p)
    os.makedirs(root, exist_ok=True)
    stamp = dt.datetime.now().strftime('%Y%m%d_%H%M%S')
    path = os.path.join(root, f'{stamp}_{workflow}')
    os.makedirs(os.path.join(path, 'ros_log'))         # fails if it exists: one directory per session
    open(os.path.join(path, '.sct-session'), 'w').close()
    return path


def sessions(p):
    root = log_root(p)
    out = []
    if not os.path.isdir(root):
        return out
    for name in sorted(os.listdir(root)):
        d = os.path.join(root, name)
        if not os.path.isfile(os.path.join(d, '.sct-session')):
            continue                                   # never touch directories the launcher did not create
        info = {}
        try:
            info = json.load(open(os.path.join(d, 'session.json')))
        except (OSError, ValueError):
            pass
        logs = os.path.join(d, 'ros_log')
        size = sum(os.path.getsize(os.path.join(a, f)) for a, _, fs in os.walk(logs) for f in fs) if os.path.isdir(logs) else 0
        pid = info.get('pid')
        alive = bool(pid) and os.path.exists(os.path.join(PROC, str(pid)))
        out.append(dict(dir=d, size=size, mtime=os.path.getmtime(d), alive=alive, has_logs=os.path.isdir(logs)))
    return out


def tool_log_dir(p, tool, dry_run):
    """ROS_LOG_DIR for a helper process: inside the running workflow's session, else its own."""
    held = lock_info('workflow') or {}
    if held.get('session'):
        return os.path.join(held['session'], f'ros_log_{tool}')
    if dry_run:
        return f'(new {tool} session)/ros_log'
    return os.path.join(new_session(p, tool), 'ros_log')


def free_gb(path):
    while not os.path.exists(path):
        path = os.path.dirname(path)
    return shutil.disk_usage(path).free / 1e9


# ---- commands -----------------------------------------------------------------------
def env_diff(env):
    shown = ('ROS_DOMAIN_ID', 'RMW_IMPLEMENTATION', 'ROS_DISCOVERY_SERVER', 'ROS_LOCALHOST_ONLY', 'ROS_SUPER_CLIENT',
             'ROS_LOG_DIR', 'ROBOT_MAP_DIR', 'AMENT_PREFIX_PATH')
    return {k: env[k] for k in shown if k in env}


def workflow_argv(p, workflow):
    m, n = resolve_data(p)
    base = [f'robot_id:={p["ROBOT_ID"]}', f'lidar_yaw:={p["LIDAR_YAW"]}']
    if workflow == 'manual':
        return ['ros2', 'launch', 'robot_control', 'manual_mode.launch.py', *base]
    if workflow == 'map':
        return ['ros2', 'launch', 'robot_control', 'manual_mapping.launch.py', *base,
                f'max_wheel_speed_mm_s:={p["MAP_MAX_WHEEL_SPEED_MM_S"]}', 'rviz:=false']
    return ['ros2', 'launch', 'robot_navigation', 'navigation.launch.py', *base, f'map:={m}',
            'enable_camera:=false', 'rviz:=false', f'nav2_params_file:={n}']


def check_workflow(p, env, workflow, procs):
    ok, why = calibration(p)
    if not ok:
        raise Refused(f'calibration: {why}')
    held = lock_info('workflow')
    if held:
        raise Refused(f'workflow {held.get("workflow")} already running (pid {held.get("pid")}, {held.get("session")})')
    running = robot_nodes(procs)
    if running:
        raise Refused('robot processes already running (started outside robot?): ' +
                      ', '.join(f'{x["name"]}[{x["pid"]}]' for x in running))
    m, n = resolve_data(p)
    if workflow == 'nav':
        for what, path in (('map', m), ('NAV2_PARAMS', n)):
            if not os.path.isfile(path):
                raise Refused(f'{what} not found: {path}')
        if not package_prefix(env, 'robot_nav_plugins'):
            raise Refused('robot_nav_plugins is not in this runtime (Nav2 V2 needs LatchedGoalChecker); '
                          'set SCT_OVERLAY to an overlay that has it')
    for pkg in ('robot_control', 'stm32_bridge', 'robot_description') + (('robot_navigation',) if workflow == 'nav' else ()):
        if not package_prefix(env, pkg):
            raise Refused(f'package {pkg} not found in this runtime')
    if free_gb(log_root(p)) < float(p['MIN_FREE_GB']):
        raise Refused(f'less than {p["MIN_FREE_GB"]} GB free under {log_root(p)}')


def check_teleop(p, env, procs):
    mm = [x for x in procs if x['name'] == 'mode_manager_node']
    if not mm:
        raise Refused('no mode_manager is running: start "robot manual" or "robot map" first')
    if len(mm) > 1:
        raise Refused(f'{len(mm)} mode_manager processes: two workflows are running')
    if mm[0]['domain'] and mm[0]['domain'] != env['ROS_DOMAIN_ID']:
        raise Refused(f'mode_manager runs on domain {mm[0]["domain"]}, this profile on {env["ROS_DOMAIN_ID"]}')
    want_ns = '/' + p['ROBOT_ID']
    if mm[0]['namespace'] and mm[0]['namespace'] != want_ns:
        raise Refused(f'mode_manager namespace {mm[0]["namespace"]} differs from ROBOT_ID {want_ns}')
    other = [x for x in procs if x['name'] in COMMAND_SOURCES]
    if other or lock_info('teleop'):
        raise Refused('another teleop is already running: ' + ', '.join(f'{x["name"]}[{x["pid"]}]' for x in other))


def run(argv, env, dry_run, lock=None, session=None, extra_env=None):
    env = dict(env, **(extra_env or {}))
    if dry_run:
        print(json.dumps(dict(argv=argv, env=env_diff(env), session=session, lock=lock), indent=1))
        return 0
    fd = None
    if lock:
        fd = take_lock(lock[0], lock[1])
    if session:
        json.dump(dict(argv=argv, pid=os.getpid(), env=env_diff(env), started=dt.datetime.now().isoformat()),
                  open(os.path.join(session, 'session.json'), 'w'), indent=1)
    sys.stdout.flush()
    test_exec = os.environ.get('SCT_ROBOT_TEST_EXEC')     # offline tests only: run this instead of argv[0]
    if test_exec:
        os.execve(test_exec, [test_exec, *argv], env)
    os.execvpe(argv[0], argv, env)


def cmd_status(p):
    ok_cal, why = calibration(p)
    m, n = resolve_data(p)
    print(f'profile      {PROFILE}')
    print(f'robot root   {p["SCT_ROBOT_ROOT"]}  (.env, base install, maps)')
    print(f'overlay      {p["SCT_OVERLAY"] or "(none)"}')
    prov = os.path.join(os.path.dirname(p['SCT_OVERLAY'].rstrip('/')), 'PROVENANCE') if p['SCT_OVERLAY'] else ''
    if prov and os.path.isfile(prov):
        print('             ' + ' | '.join(open(prov).read().split('\n')[:2]))
    elif p['SCT_OVERLAY']:
        print('             no PROVENANCE file: not built by stage-runtime (may follow a checkout)')
    try:
        env = build_env(p)
        print(f'DDS          domain {env["ROS_DOMAIN_ID"]}, {env["RMW_IMPLEMENTATION"]}, discovery '
              f'{env["ROS_DISCOVERY_SERVER"]}, localhost_only {env.get("ROS_LOCALHOST_ONLY", "0")}')
        for pkg in ('stm32_bridge', 'robot_control', 'robot_navigation', 'robot_nav_plugins'):
            print(f'  {pkg:18s} {package_prefix(env, pkg) or "MISSING"}')
    except Refused as exc:
        print(f'environment  REFUSED: {exc}')
    print(f'robot_id     {p["ROBOT_ID"]}')
    print(f'lidar_yaw    {p["LIDAR_YAW"]} rad -> {"usable" if ok_cal else "NOT usable"} for motion: {why}')
    if p['LIDAR_YAW_CANDIDATE']:
        print(f'candidate    {p["LIDAR_YAW_CANDIDATE"]} rad (static check only: robot lidar-check)')
    print(f'map / params {m} | {n}')
    procs = scan_processes()
    held = lock_info('workflow')
    print(f'workflow     {"running: " + json.dumps(held) if held else "none (no launcher lock)"}')
    for x in procs:
        print(f'  {x["name"]:18s} pid {x["pid"]:<7d} domain {x["domain"]} ns {x["namespace"]}')
    if not procs:
        print('  no robot, teleop, recorder or stop-key process')
    ss = sessions(p)
    total = sum(s['size'] for s in ss) / 1e6
    print(f'logs         {len(ss)} launcher sessions under {log_root(p)}, ros_log {total:.0f} MB '
          f'(budget {p["LOG_MAX_MB"]} MB, keep {p["LOG_KEEP_DAYS"]} days), {free_gb(log_root(p)):.1f} GB free')
    return 0


def cmd_logs(p, prune, yes):
    ss = sessions(p)
    if not prune:
        for s in ss:
            print(f'{s["size"] / 1e6:8.1f} MB  {"LIVE " if s["alive"] else "     "}{s["dir"]}')
        print(f'{sum(s["size"] for s in ss) / 1e6:8.1f} MB total in {len(ss)} launcher sessions')
        return 0
    keep_s = float(p['LOG_KEEP_DAYS']) * 86400
    budget = float(p['LOG_MAX_MB']) * 1e6
    now = time.time()
    candidates = [s for s in ss if s['has_logs'] and not s['alive']]
    held = lock_info('workflow') or {}
    candidates = [s for s in candidates if s['dir'] != held.get('session')]
    chosen = [s for s in candidates if now - s['mtime'] > keep_s]
    total = sum(s['size'] for s in ss) - sum(s['size'] for s in chosen)
    for s in sorted(candidates, key=lambda s: s['mtime']):
        if total <= budget:
            break
        if s not in chosen:
            chosen.append(s)
            total -= s['size']
    for s in chosen:
        print(f'{"removing" if yes else "would remove"} {s["dir"]}/ros_log ({s["size"] / 1e6:.1f} MB); bag and session.json kept')
        if yes:
            shutil.rmtree(os.path.join(s['dir'], 'ros_log'))
    if not chosen:
        print('nothing to prune')
    elif not yes:
        print('dry run: add --yes to remove')
    return 0


def cmd_accept(p, directory, yes):
    v = read_verdict(directory)
    if v.get('verdict') != 'PASS' or v.get('tf_ok') != 'True':
        raise Refused(f'{directory}: verdict {v.get("verdict")}, tf_ok {v.get("tf_ok")}; only a PASS can be accepted')
    if not p['LIDAR_YAW_CANDIDATE'] or not angle_equal(v.get('candidate_rad', 'nan'), p['LIDAR_YAW_CANDIDATE']):
        raise Refused(f'the check measured {v.get("candidate_rad")}, the profile candidate is {p["LIDAR_YAW_CANDIDATE"]!r}')
    new = {'LIDAR_YAW': v['candidate_rad'], 'LIDAR_YAW_EVIDENCE': os.path.abspath(directory),
           'LIDAR_YAW_PREVIOUS': p['LIDAR_YAW']}
    print(f'LIDAR_YAW {p["LIDAR_YAW"]} -> {new["LIDAR_YAW"]} (wall check difference {v.get("difference_deg")} deg)')
    if not yes:
        print('dry run: add --yes to write the profile (a timestamped backup is kept)')
        return 0
    backup = f'{PROFILE}.bak-{dt.datetime.now():%Y%m%d_%H%M%S}'
    shutil.copy2(PROFILE, backup)
    lines, seen = [], set()
    for raw in open(PROFILE, encoding='utf-8'):
        key = raw.split('=', 1)[0].strip()
        if key in new:
            lines.append(f'{key}={new[key]}\n')
            seen.add(key)
        else:
            lines.append(raw)
    lines += [f'{k}={v}\n' for k, v in new.items() if k not in seen]
    tmp = PROFILE + '.tmp'
    open(tmp, 'w', encoding='utf-8').writelines(lines)
    os.replace(tmp, PROFILE)
    print(f'written; backup {backup}. Roll back: cp {backup} {PROFILE}')
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog='robot', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='cmd')
    sub.add_parser('status')
    sub.add_parser('env')
    sub.add_parser('shell')
    for w in WORKFLOWS:
        sub.add_parser(w).add_argument('--dry-run', action='store_true')
    t = sub.add_parser('teleop')
    t.add_argument('--dry-run', action='store_true')
    t.add_argument('--speed', type=float)
    t.add_argument('--turn', type=float)
    sub.add_parser('stop').add_argument('--dry-run', action='store_true')
    pf = sub.add_parser('preflight')
    pf.add_argument('workflow', choices=WORKFLOWS)
    pf.add_argument('--static', action='store_true')
    pf.add_argument('--dry-run', action='store_true')
    rec = sub.add_parser('record')
    rec.add_argument('action', choices=('start', 'stop'))
    rec.add_argument('dir', nargs='?')
    rec.add_argument('--dry-run', action='store_true')
    lc = sub.add_parser('lidar-check', help='args after -- go to static_lidar_check.sh')
    lc.add_argument('--dry-run', action='store_true')
    lc.add_argument('rest', nargs=argparse.REMAINDER)
    cal = sub.add_parser('calibration')
    cal.add_argument('action', choices=('accept',))
    cal.add_argument('dir')
    cal.add_argument('--yes', action='store_true')
    lg = sub.add_parser('logs')
    lg.add_argument('action', nargs='?', choices=('prune',))
    lg.add_argument('--yes', action='store_true')
    a = ap.parse_args(argv)
    try:
        p = load_profile()
        if a.cmd in (None, 'status'):
            return cmd_status(p)
        if a.cmd == 'logs':
            return cmd_logs(p, a.action == 'prune', a.yes)
        if a.cmd == 'calibration':
            return cmd_accept(p, a.dir, a.yes)
        env = build_env(p)
        if a.cmd == 'env':
            for k, v in sorted(env.items()):
                print(f'{k}={v}')
            return 0
        if a.cmd == 'shell':
            env['PS1'] = f'[robot {p["ROBOT_ID"]} d{env["ROS_DOMAIN_ID"]}] \\w$ '
            os.execvpe('bash', ['bash', '--noprofile', '--norc', '-i'], env)
        procs = scan_processes()
        tools = os.path.join(ROBOT_DIR, 'tools')
        if a.cmd in WORKFLOWS:
            check_workflow(p, env, a.cmd, procs)
            argv = workflow_argv(p, a.cmd)
            if a.dry_run:
                return run(argv, env, True, lock=('workflow', a.cmd), session='(new session directory)')
            session = new_session(p, a.cmd)
            return run(argv, env, False, lock=('workflow', dict(workflow=a.cmd, pid=os.getpid(), session=session)),
                       session=session, extra_env={'ROS_LOG_DIR': os.path.join(session, 'ros_log')})
        if a.cmd == 'teleop':
            speed = a.speed if a.speed is not None else float(p['TELEOP_SPEED'])
            turn = a.turn if a.turn is not None else float(p['TELEOP_TURN'])
            if not (0 < speed <= TELEOP_LIMITS['TELEOP_SPEED'] and 0 < turn <= TELEOP_LIMITS['TELEOP_TURN']):
                raise Refused(f'speed/turn above the caps {TELEOP_LIMITS}')
            if not a.dry_run:
                check_teleop(p, env, procs)
            log_dir = tool_log_dir(p, 'teleop', a.dry_run)
            argv = ['ros2', 'run', 'teleop_twist_keyboard', 'teleop_twist_keyboard', '--ros-args',
                    '-r', f'cmd_vel:=/{p["ROBOT_ID"]}/cmd_vel_manual', '-p', f'speed:={speed}', '-p', f'turn:={turn}']
            return run(argv, env, a.dry_run, lock=('teleop', dict(pid=os.getpid())), extra_env={'ROS_LOG_DIR': log_dir})
        if a.cmd == 'stop':
            argv = ['python3', os.path.join(tools, 'ops', 'stopkey.py'), '/' + p['ROBOT_ID']]
            if not a.dry_run:
                print('robot stop = SOFTWARE stop key. It does NOT cut motor power; the hardware E-stop is the physical button.')
            return run(argv, env, a.dry_run, extra_env={'ROS_LOG_DIR': tool_log_dir(p, 'stop', a.dry_run)})
        if a.cmd == 'preflight':
            names = {'manual': 'manual', 'map': 'mapping', 'nav': 'navigation'}
            argv = ['python3', os.path.join(tools, 'preflight', 'preflight.py'), names[a.workflow],
                    '--lidar-yaw', p['LIDAR_YAW'], '--ns', '/' + p['ROBOT_ID']] + (['--static'] if a.static else [])
            return run(argv, env, a.dry_run, extra_env={'ROS_SUPER_CLIENT': 'TRUE',
                                                        'ROS_LOG_DIR': tool_log_dir(p, 'preflight', a.dry_run)})
        if a.cmd == 'record':
            held = lock_info('workflow') or {}
            d = a.dir or held.get('session')
            if not d:
                raise Refused('no session directory: give one, or start a workflow with robot first')
            argv = ['bash', os.path.join(tools, 'ops', 'record_session.sh'), a.action, d]
            return run(argv, env, a.dry_run, extra_env={'ROBOT_NS': '/' + p['ROBOT_ID']})
        if a.cmd == 'lidar-check':
            if not p['LIDAR_YAW_CANDIDATE']:
                raise Refused('LIDAR_YAW_CANDIDATE is not set in the profile')
            if robot_nodes(procs) or lock_info('workflow'):
                raise Refused('stop the running workflow first; the static check owns the LiDAR alone')
            rest = [x for x in a.rest if x != '--']
            if '--dry-run' in rest:                    # never run the real check because the flag came late
                rest.remove('--dry-run')
                a.dry_run = True
            if '--lidar-yaw' in rest:
                raise Refused('the static check always uses LIDAR_YAW_CANDIDATE from the profile')
            argv = ['bash', os.path.join(tools, 'lidar_calibration', 'static_lidar_check.sh'), *rest,
                    '--lidar-yaw', p['LIDAR_YAW_CANDIDATE']]
            return run(argv, env, a.dry_run)
    except Refused as exc:
        print(f'REFUSED: {exc}', file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    sys.exit(main())
