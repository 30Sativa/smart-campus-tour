#!/usr/bin/env bash

# Resolve the clone this script actually lives in. Hard-coding a path under
# $HOME silently sources a stale install/ if the miniPC still has an older
# clone under a different directory name.
ROBOT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ ! -f "$ROBOT_ROOT/.env" ]; then
    echo "ERROR: $ROBOT_ROOT/.env not found"
    return 1 2>/dev/null || exit 1
fi

set -a
source "$ROBOT_ROOT/.env"
set +a

source /opt/ros/humble/setup.bash

if [ -f "$ROBOT_ROOT/ros2_ws/install/setup.bash" ]; then
    source "$ROBOT_ROOT/ros2_ws/install/setup.bash"
else
    echo "WARNING: $ROBOT_ROOT/ros2_ws/install/setup.bash not found."
    echo "         Native Astra camera packages are NOT on the path. If setting up"
    echo "         the camera host exception, build only its overlay with:"
    echo "         cd $ROBOT_ROOT/ros2_ws && colcon build --symlink-install --packages-up-to orbbec_bringup"
    echo "         Do not build or launch duplicate drivetrain/Nav2 nodes on the host."
fi

echo "ROS environment loaded:"
echo "  WS=$ROBOT_ROOT/ros2_ws"
echo "  DOMAIN=$ROS_DOMAIN_ID"
echo "  DISCOVERY=$ROS_DISCOVERY_SERVER"
echo "  RMW=$RMW_IMPLEMENTATION"
