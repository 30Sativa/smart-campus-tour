# Ubuntu 22.04 laptop standalone simulation environment
# Copy:
#   cp .env.sim.example .env
#
# Start:
#   docker compose --profile sim up -d --build

# ROS 2 local DDS discovery
ROS_DOMAIN_ID=30
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_LOCALHOST_ONLY=0

# Gazebo / RViz2 GUI on Ubuntu laptop
DISPLAY=:0
LIBGL_ALWAYS_SOFTWARE=1
