# Machine profile for robot/scripts/robot. Copy to ~/.config/sct-robot/runtime.env and edit.
# This file is machine configuration: do not commit the real one. KEY=VALUE only, no shell
# code; ~ and $HOME are expanded. Unknown keys are refused (typo protection).
# See robot/docs/robot-launcher.md.

# robot/ directory that holds .env (DDS settings), ros2_ws/install (base install) and robot_maps/.
SCT_ROBOT_ROOT=$HOME/smart-campus-tour/robot

# At most ONE overlay sourced on top of the base install, or empty for none. Changing it
# affects only commands started afterwards; running processes keep what they had.
#   current MiniPC baseline: the overlay that holds robot_nav_plugins and the 02/11 launches
#   staged:                  $HOME/.cache/sct-runtime/<sha>/install   (robot/scripts/stage-runtime)
SCT_OVERLAY=

ROBOT_ID=robot_01

# LiDAR yaw (rad) passed to EVERY workflow. It must be either a recorded baseline value
# (robot-baseline-20261102: -3.0695) or backed by LIDAR_YAW_EVIDENCE, a static check
# directory whose verdict.txt is PASS for this value. Set by `robot calibration accept`.
LIDAR_YAW=-3.0695
LIDAR_YAW_EVIDENCE=
# Value under test. Used ONLY by `robot lidar-check` (static wall check, drive power off).
LIDAR_YAW_CANDIDATE=3.1241

# Relative names resolve under SCT_ROBOT_ROOT/robot_maps and .../robot_control/config.
MAP=map2.yaml
NAV2_PARAMS=nav2_params_v2.yaml
MAP_MAX_WHEEL_SPEED_MM_S=250.0

# Keyboard teleop. Hard caps in the launcher: 0.30 m/s, 1.00 rad/s.
TELEOP_SPEED=0.1
TELEOP_TURN=0.3

# One directory per session; the launcher prunes only the ros_log/ it created there.
SCT_LOG_ROOT=$HOME/amr_logs/runs
LOG_KEEP_DAYS=30
LOG_MAX_MB=2000
MIN_FREE_GB=5
# Fleet service (robot/docs/fleet-service.md): auto = commands only while "robot nav --fleet" runs; off = telemetry only.
#FLEET_SERVICE_COMMANDS=auto
# Astra depth in the local costmap for every nav (robot/docs/depth-camera.md); robot nav --camera does it once.
#ENABLE_CAMERA=false
