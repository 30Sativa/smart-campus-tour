# Copy to quest-stream.env (git-ignored) and edit. Every value is optional.

# Where FFmpeg publishes the video: MediaMTX on this NUC. Browsers then watch
# it over WebRTC at http://<NUC_IP>:8889/<path>/whep (path = "quest" here).
# With MediaMTX publish auth: rtsp://user:pass@127.0.0.1:8554/quest
QUEST_PUBLISH_URL=rtsp://127.0.0.1:8554/quest
# Seconds between keyframes. A new viewer's picture starts on the next one,
# and a lost packet is repaired by it: 1 s is a good trade-off.
QUEST_KEYFRAME_INTERVAL=1

# Status API (/status, /health). 0.0.0.0 = reachable from the LAN.
QUEST_STREAM_HOST=0.0.0.0
QUEST_STREAM_PORT=8080
QUEST_CORS_ORIGIN=*

# Only needed when more than one ADB device is attached (adb devices -l).
QUEST_SERIAL=

# Picture: which eye, how much of it, and where the window sits.
QUEST_EYE=left
# Fraction of one eye's width kept. Lower = more zoom, less lens border.
QUEST_CROP_KEEP=0.80
# Shift the window centre (fraction of eye width/height, + = right/down).
QUEST_CROP_OFFSET_X=0
QUEST_CROP_OFFSET_Y=0
QUEST_OUTPUT_WIDTH=1280
QUEST_OUTPUT_HEIGHT=720
QUEST_FPS=30
# Full FFmpeg -vf replacement for experiments (leave empty normally).
QUEST_VF=

# Encoder: libx264 (CPU; constrained baseline) or h264_vaapi (Intel iGPU, much
# lighter on the NUC; main profile). Both without B-frames, as WebRTC requires.
QUEST_ENCODER=libx264
QUEST_X264_PRESET=veryfast
QUEST_VIDEO_BITRATE=4M
QUEST_VIDEO_MAXRATE=6M
QUEST_VIDEO_BUFSIZE=8M
# vaapi = decode the Quest's H.264 on the iGPU as well (needs intel-media-va-driver)
QUEST_HWDEC=
QUEST_VAAPI_DEVICE=/dev/dri/renderD128

# Capture on the headset (adb screenrecord).
# Smaller capture = less decode work on the NUC, e.g. 2560x1344. Empty = native.
QUEST_CAPTURE_SIZE=
QUEST_CAPTURE_BITRATE=20000000
QUEST_SCREENRECORD_LIMIT=180
# 1 = disable the proximity sensor while streaming so the Quest stays awake
# when nobody wears it (re-enabled when the stream stops).
QUEST_KEEP_AWAKE=0

# Seconds without video from the Quest before the pipeline restarts.
QUEST_STALL_TIMEOUT=10
