# Quest 3 (USB) -> FFmpeg -> MediaMTX. Installed by scripts/install-services.sh,
# which replaces __DIR__ and __USER__. The server waits for the Quest and for
# MediaMTX by itself; systemd only restarts it after a crash.
[Unit]
Description=Quest 3 USB capture -> MediaMTX (Smart Campus Tour)
After=network-online.target mediamtx.service
Wants=network-online.target mediamtx.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/scripts/start-stream.sh --foreground
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
