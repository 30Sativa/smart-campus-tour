# MediaMTX settings for the Quest stream. scripts/install-services.sh copies
# this to mediamtx.env (git-ignored) the first time; edit that copy, then:
#   sudo systemctl restart mediamtx
#
# Every MTX_<KEY> overrides <key> in /usr/local/etc/mediamtx.yml (the stock
# config that ships with MediaMTX), so this file only lists what we change.
# Ports stay at MediaMTX defaults:
#   8554/tcp  RTSP     - quest-stream publishes here (localhost only, below)
#   8889/tcp  WebRTC   - browsers: http://<NUC_IP>:8889/quest/whep
#   8189/udp  WebRTC   - the video itself (open it in the firewall)
#   8888/tcp  HLS      - fallback / debugging: http://<NUC_IP>:8888/quest

MTX_LOGLEVEL=info

# Only processes on the NUC can publish or read RTSP; nobody on the LAN can
# push their own video onto the "quest" path.
MTX_RTSPADDRESS=127.0.0.1:8554

# Browsers watch over WebRTC.
MTX_WEBRTC=yes
MTX_WEBRTCADDRESS=:8889
MTX_WEBRTCLOCALUDPADDRESS=:8189
# MediaMTX offers every interface's IP to the browser by itself. Add the NUC's
# LAN IP (or a hostname) here only if a viewer cannot connect, e.g. when the
# NUC sits behind NAT or Docker bridges confuse the candidate list:
#MTX_WEBRTCADDITIONALHOSTS=10.80.192.207

# HLS stays on for quick checks in any player (VLC, Safari), remuxed on demand.
MTX_HLS=yes
MTX_HLSADDRESS=:8888

# Not used.
MTX_RTMP=no
MTX_SRT=no

# Local API for scripts/measure.sh and check-quest.sh (not reachable from the LAN).
MTX_API=yes
MTX_APIADDRESS=127.0.0.1:9997
