# Topics are RELATIVE on purpose: they resolve under RViz's own namespace.
#   no namespace:  rviz2 -d navigation.rviz                          -> /map
#   robot_01:      rviz2 -d navigation.rviz --ros-args -r __ns:=/robot_01 -> /robot_01/map
# RViz's topic drop-down offers absolute names; re-type them relative before
# saving. test_nav2_baseline_contract.py checks this.
# Start with Grid + Map while AMCL waits for 2D Pose Estimate.
# Once map -> odom is available, enable other displays as needed.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Sonar - display only1
      Splitter Ratio: 0.55
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Color: 160; 160; 164
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map (saved)
      Enabled: true
      Topic:
        Value: map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: false
      Alpha: 0.3
      Topic:
        Value: global_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Value: false
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: false
      Alpha: 0.6
      Topic:
        Value: local_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Value: false
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR /scan
      Enabled: false
      Topic:
        Value: scan
        Reliability Policy: Best Effort
      Size (m): 0.03
      Color: 255; 255; 0
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Astra depth
      Enabled: false
      Topic:
        Value: camera/depth/points
        Reliability Policy: Best Effort
      Size (m): 0.02
      Style: Points
      Color Transformer: AxisColor
      Value: false
    # Checkboxes only control visualization; they do not enable costmap layers.
    - Class: rviz_common/Group
      Name: Sonar - display only
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Range
          Name: Sonar 1 - Front Left
          Enabled: false
          Topic:
            Value: ultrasonic/sonar1/range
            Depth: 5
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
          Color: 0; 220; 80
          Alpha: 0.45
          Buffer Length: 1
          Value: false
        - Class: rviz_default_plugins/Range
          Name: Sonar 2 - Front Right
          Enabled: false
          Topic:
            Value: ultrasonic/sonar2/range
            Depth: 5
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
          Color: 255; 210; 0
          Alpha: 0.45
          Buffer Length: 1
          Value: false
        - Class: rviz_default_plugins/Range
          Name: Sonar 3 - Rear Left
          Enabled: false
          Topic:
            Value: ultrasonic/sonar3/range
            Depth: 5
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
          Color: 0; 160; 255
          Alpha: 0.45
          Buffer Length: 1
          Value: false
        - Class: rviz_default_plugins/Range
          Name: Sonar 4 - Rear Right
          Enabled: false
          Topic:
            Value: ultrasonic/sonar4/range
            Depth: 5
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
          Color: 255; 100; 180
          Alpha: 0.45
          Buffer Length: 1
          Value: false
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: false
      Description Topic:
        Value: robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Value: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/Path
      Name: Global Path
      Enabled: false
      Topic:
        Value: plan
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Value: false
    - Class: rviz_default_plugins/Path
      Name: RPP Transformed Path
      Enabled: false
      Topic:
        Value: received_global_plan
        Reliability Policy: Reliable
      Color: 255; 0; 255
      Value: false
    - Class: rviz_default_plugins/Polygon
      Name: Local Footprint
      Enabled: false
      Topic:
        Value: local_costmap/published_footprint
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 0; 255; 255
      Value: false
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL Particles
      Enabled: false
      Topic:
        Value: particle_cloud
        Reliability Policy: Best Effort
      Value: false
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: initialpose
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Pitch: 1.2
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
  Hide Left Dock: false
  Hide Right Dock: false
