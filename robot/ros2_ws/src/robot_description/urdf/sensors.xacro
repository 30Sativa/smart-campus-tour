<?xml version="1.0"?>
<!-- =========================================================================
     sensors.xacro
     LiDAR 2D + IMU + 4 SR04T.
     LiDAR/sonar positions from CAD; sonar yaw/channel mapping and IMU remain provisional.
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================ LiDAR 2D ============================ -->
  <!-- Kich thuoc, tam va mesh origin do truc tiep tu lidar_body.stl. -->
  <xacro:property name="lidar_radius" value="0.038679932"/>
  <xacro:property name="lidar_height" value="0.0405"/>
  <xacro:property name="lidar_x" value="-0.001439453"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="0.266499969"/>

  <link name="lidar_link">
    <visual>
      <origin xyz="-1.637052856 -0.744854340 -1.430997681"
              rpy="${cad_to_ros_rpy}"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/lidar_body.stl"
              scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.2" r="${lidar_radius}" h="${lidar_height}"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <material>Gazebo/Blue</material>
    <sensor name="lidar" type="ray">
      <pose>0 0 0.03 0 0 0</pose>
      <!-- false: khong ve tia laser trong gzclient (nhe hon nhieu cho VM);
           van co topic /scan, xem tia trong RViz. -->
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.141592</min_angle>
            <max_angle>3.141592</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- =========================== SR04T x4 =========================== -->
  <!-- Range frames point along local +X. CAD Point2/3/5/4 map to the existing
       front-left/front-right/rear-left/rear-right frame convention below.
       Electrical channel mapping and diagonal yaw still require confirmation.
       All four sensors pitch DOWN 4 degrees, confirmed by the user.
       Measurements and remaining checks: robot/docs/cad-sensor-mounts.md. -->
  <xacro:property name="sonar_body_depth" value="0.025"/>
  <xacro:property name="sonar_body_width" value="0.045"/>
  <xacro:property name="sonar_body_height" value="0.025"/>
  <xacro:property name="sonar_mount_pitch" value="0.06981317007977318"/>

  <xacro:macro name="sr04t_link" params="name x y z yaw material">
    <link name="${name}">
      <visual>
        <!-- Link origin is the acoustic face; body extends into the chassis. -->
        <origin xyz="${-sonar_body_depth/2} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${sonar_body_depth} ${sonar_body_width} ${sonar_body_height}"/>
        </geometry>
        <material name="${material}"/>
      </visual>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 ${sonar_mount_pitch} ${yaw}"/>
    </joint>
  </xacro:macro>

  <!-- Point2, front-left. SONAR1 (PB0/PB1) mapping and +45 deg yaw provisional. -->
  <xacro:sr04t_link name="sonar1_link"
                     x="0.388507690" y="0.268345645" z="0.009502289"
                     yaw="0.78539816340" material="green"/>

  <!-- Point3, front-right. SONAR2 (PB11/PB12) mapping and -45 deg yaw provisional. -->
  <xacro:sr04t_link name="sonar2_link"
                     x="0.388407690" y="-0.268354355" z="0.009802289"
                     yaw="-0.78539816340" material="yellow"/>

  <!-- Point5, rear-left. SONAR3 (PB13/PB14) mapping and +135 deg yaw provisional. -->
  <xacro:sr04t_link name="sonar3_link"
                     x="-0.388492310" y="0.268445645" z="0.009802289"
                     yaw="2.35619449019" material="blue"/>

  <!-- Point4, rear-right. SONAR4 (PB15/PA6) mapping and -135 deg yaw provisional. -->
  <xacro:sr04t_link name="sonar4_link"
                     x="-0.388492310" y="-0.268354355" z="0.009502289"
                     yaw="-2.35619449019" material="orange"/>

  <!-- ============================== IMU =============================== -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.03 0.03 0.01"/></geometry>
      <material name="orange"/>
    </visual>
    <xacro:box_inertia m="0.05" x="0.03" y="0.03" z="0.01"/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

</robot>
