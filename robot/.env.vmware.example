# Ubuntu 22.04 laptop debug environment (legacy filename; also usable in VMware)
# Copy:
#   cp .env.vmware.example .env
#
# Start:
#   docker compose --profile debug up -d --build

# ROS 2 networking
ROS_DOMAIN_ID=30
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_LOCALHOST_ONLY=0

# Fast DDS Discovery Server trên MiniPC qua Tailscale MagicDNS.
# Không hard-code IP Wi-Fi/LAN.
ROS_DISCOVERY_SERVER=amr-minipc:11811

# GUI / RViz2 trên Ubuntu laptop
DISPLAY=:0
LIBGL_ALWAYS_SOFTWARE=1
