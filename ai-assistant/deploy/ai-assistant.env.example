# Copy to /etc/campustour/ai-assistant.env on the EC2 host (root:root, mode 0600). Never commit filled values.
# AI_SERVICE_KEY must equal AiAssistant__ServiceKey in /etc/campustour/api.env. Generate: openssl rand -hex 32
AI_SERVICE_KEY=
AI_PROVIDER=anthropic
# Anthropic Console > API Keys. Model defaults to claude-haiku-5-5 (cheapest).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_EFFORT=low
