# Copy to ai-assistant/.env (untracked) and fill in. Never commit real values.
# Contract: docs/architecture.md §7.1.

# Shared secret the backend sends as "Authorization: Bearer <key>". Required.
AI_SERVICE_KEY=

# gemini (default) or fake. "fake" answers from the content pack without any
# LLM call; use it only for local development and tests.
AI_PROVIDER=gemini

# Gemini API key from Google AI Studio and the model ID (a Flash-tier model).
GEMINI_API_KEY=
GEMINI_MODEL=
# Reasoning effort: low (default), minimal (not on every model) or empty for the model default.
# GEMINI_THINKING_LEVEL=low

# Optional overrides (defaults shown).
# AI_HOST=127.0.0.1
# AI_PORT=8090
# AI_CONTENT_DIR=content
# AI_REQUEST_BUDGET_SECONDS=18
# AI_LLM_ATTEMPT_TIMEOUT_SECONDS=15
# AI_RETRY_MIN_REMAINING_SECONDS=5
# AI_MAX_CONCURRENT_LLM_CALLS=8
# AI_CACHE_MAX_ENTRIES=512
# AI_CACHE_TTL_SECONDS=3600
# AI_CIRCUIT_FAILURE_THRESHOLD=5
# AI_CIRCUIT_RESET_SECONDS=30
