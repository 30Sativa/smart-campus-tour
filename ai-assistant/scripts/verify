#!/usr/bin/env bash
# ai-assistant verification. Contract: exit 0 pass, non-zero fail, 3 = skipped.
# Today: content pack + evaluation set checks (stdlib Python).
# TODO(WP4): add ruff, pytest and the offline evaluation run with the first
# Python source (pyproject.toml) — see ai-assistant/AGENTS.md §4.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

PY="${PYTHON:-}"
if [ -z "$PY" ]; then
  for c in python3 python; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(sys.version_info < (3, 10))'; then PY="$c"; break; fi
  done
fi
if [ -z "$PY" ]; then
  echo "FAIL: Python 3.10+ not found (set PYTHON=...)."
  exit 1
fi

echo "== content checker tests"
"$PY" -m unittest discover -s scripts -p 'test_*.py'
echo "== content pack and evaluation set"
"$PY" scripts/check_content.py

if [ -f pyproject.toml ] || [ -f package.json ] || [ -f go.mod ]; then
  echo "FAIL: ai-assistant/ has source but scripts/verify does not check it yet."
  echo "      Add the real code checks before adding source."
  exit 1
fi
echo "PASS: content checks (no service source yet)."
